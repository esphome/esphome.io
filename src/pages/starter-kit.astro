---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import Buy from "@components/Buy.astro";

import { getEntry } from "astro:content";
import FAQ from "@components/FAQ.astro";

const faq = await getEntry("faq", "starter-kit");
---

<StarlightPage
  frontmatter={{
    title: "ESPHome Starter Kit",
    template: "splash",
  }}
>
  <p>Hello world!</p>

  <Buy
    strapline="Ready to build, learn, and automate?"
    dollars="XX"
    euros="XX"
  />

  <FAQ heading="Frequently asked questions" items={faq.data.items} />
</StarlightPage>
