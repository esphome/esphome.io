---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import Nav from "@components/starter-kit/Nav.astro";
import Hero from "@components/starter-kit/Hero.astro";
import YourWay from "@components/starter-kit/YourWay.astro";
import GallerySection from "@components/starter-kit/GallerySection.astro";
import Succeed from "@components/starter-kit/Succeed.astro";
import WhatsPossible from "@components/starter-kit/WhatsPossible.astro";
import Collaboration from "@components/Collaboration.astro";
import Buy from "@components/Buy.astro";

import { getEntry } from "astro:content";
const faq = await getEntry("faq", "starter-kit");
import FAQ from "@components/FAQ.astro";
---

<StarlightPage
  frontmatter={{
    title: "ESPHome Starter Kit",
    template: "splash",
    head: [
      {
        tag: "link",
        attrs: { rel: "preconnect", href: "https://fonts.googleapis.com" },
      },
      {
        tag: "link",
        attrs: {
          rel: "preconnect",
          href: "https://fonts.gstatic.com",
          crossorigin: true,
        },
      },
      {
        tag: "link",
        attrs: {
          rel: "stylesheet",
          href: "https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&display=swap",
        },
      },
    ],
  }}
>
  <div class="ha-connect">
    <Nav />
    <Hero />
    <YourWay />
    <GallerySection />
    <Succeed />
    <WhatsPossible />
    <Collaboration />

    <Buy
      strapline="Ready to build, learn, and automate?"
      dollars="XX"
      euros="XX"
    />

    <FAQ heading="Frequently asked questions" items={faq.data.items} />
  </div>
</StarlightPage>

<style lang="scss">
  @use "../styles/mixins" as *;

  :global(.sl-container) {
    --sl-content-width: 100%;

    max-width: var(--sl-content-width);
  }

  :root {
    --esk-body-colour: #8193a2;
    --esk-title-colour: #ffffff;

    --sl-color-text: var(--esk-body-colour);

    --container-max-width: 1200px;
    --container-full-max-width: 1200px;
    --container-gutters: 24px;

    --esk-primary-color: #9abd32;
    --esk-primary-color--light: #f5f8ea;

    --esk-heading-font: "Figtree", "Helvetica Neue", Arial, sans-serif;
    --esk-body-font: "Figtree", "Helvetica Neue", Arial, sans-serif;

    --sl-content-gap-y: 0;

    --esk-card-background: radial-gradient(
      233.58% 121.31% at 0% 2.72%,
      rgba(154, 189, 50, 0) 0%,
      rgba(154, 189, 50, 0.05) 100%
    );
  }

  :root[data-theme="light"] {
    --esk-body-colour: #4f606e;
    --esk-title-colour: #002e3e;
  }

  body {
    font-family: var(--esk-body-font);
  }

  :global(.esk-btn) {
    border-radius: 2.5rem;
    background-color: var(--esk-primary-color);
    text-transform: uppercase;

    border: none;
    outline: none;
  }

  :global(h2),
  :global(h3) {
    color: var(--esk-title-colour);
    letter-spacing: -1px;
  }

  :global(.container),
  :global(footer) {
    width: 100%;
    height: 100%;
    display: flex;
    margin: 0 auto;
    max-width: calc(
      var(--container-max-width) + (var(--container-gutters) * 2)
    );
    padding: 12px calc(var(--container-gutters) / 2);

    @include bp(desktop) {
      padding: 12px var(--container-gutters);
    }

    @include bp(1248px) {
      max-width: calc(var(--container-max-width));
      padding: 12px 0;
    }
  }

  :global(.container-full) {
    width: 100%;
    margin: 0 auto;
    padding: 0 calc(var(--container-gutters) / 2);
    max-width: calc(
      var(--container-full-max-width) + (var(--container-gutters) * 2)
    );

    @include bp(desktop) {
      padding: 0 var(--container-gutters);
    }
  }

  :global(.content-panel:has(.no-page-title)) {
    padding: 0;
    display: none;
  }

  :global(.content-panel) {
    padding: 0;
  }

  :global(section) {
    &.block-your-way,
    &.block-gallery,
    &.block-succeed,
    &.block-whats-possible,
    &.block-collaboration,
    &.block-buy {
      @include fluid(52, 128, $property: padding-bottom);
    }
  }
</style>
