---
import { LinkButton } from "@astrojs/starlight/components";

const marqueeItems = [
  { title: "No complex coding", text: "Simple configuration files do the work for you" },
  { title: "Wireless updates", text: "Upgrade devices remotely over WiFi – no cables needed" },
  { title: "Modular design", text: "Choose from hundreds of components to suit your project" },
  { title: "Local control", text: "Run your devices on your own network, without the cloud" },
];
---

<section class="hero">
  <!-- bg image -->
  <div class="container">
    <div class="content">
      <h1>Custom smart home devices, built by you</h1>
      <p>
        When you can’t find the smart home device you need in a store, build it yourself! Turn inexpensive components
        into sensors, switches, displays, and more – just tell ESPHome what to do and it handles the rest, with no need
        to code unless you want to.
      </p>
      <LinkButton href="/install/">Get started</LinkButton>
    </div>

    <div class="links">
      <div class="card card-bgc">
        <p class="card__title h2">New to ESPHome?</p>

        <LinkButton href="/#how-it-works" class="card__text-link" icon="right-arrow" iconPlacement="start"
          >How it works</LinkButton
        >
      </div>

      <div class="card card-bgc">
        <p class="card__title h2">Already using ESPHome?</p>

        <LinkButton href="/install/" class="card__text-link" icon="right-arrow" iconPlacement="start"
          >Go to documentation</LinkButton
        >
        <LinkButton href="/components/" class="card__text-link" icon="right-arrow" iconPlacement="start"
          >Browse components</LinkButton
        >
      </div>
    </div>
  </div>
  <div class="marquee">
    <div class="marquee__track">
      {
        [...marqueeItems, ...marqueeItems].map((item) => (
          <div class="item">
            <span>{item.title}</span> {item.text}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../styles/mixins" as *;

  .hero {
    display: flex;
    flex-direction: column;
    background-color: black;
    padding-bottom: 2rem;

    .container {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding-top: 6rem;
      padding-bottom: 6rem;
      color: #fff;

      @include bp(desktop) {
        flex-direction: row;
        justify-content: space-between;
      }
    }

    .content {
      @include bp(desktop) {
        max-width: 48%;
      }

      h1 {
        margin-bottom: 1.5rem;
        color: #fff;
      }

      a {
        margin-top: 1.5rem;
      }
    }

    .links {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 2rem;

      @include bp(580px) {
        flex-direction: row;
        align-items: stretch;
      }

      @include bp(desktop) {
        flex-direction: column;
        align-items: flex-end;
      }

      .card {
        width: 100%;
        padding: 1.25rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        background-color: #23272e;
        border-color: #2d3748;

        @include bp(desktop) {
          max-width: 260px;
        }

        &__title {
          font-size: 1rem;
          margin: 0;
          color: #ffffff;
        }

        &__text-link {
          margin: 0;
          font-size: 0.875rem;
          color: #b3c7ff;
        }
      }
    }

    .marquee {
      overflow: hidden;
      width: 100%;
      margin-top: auto;

      &__track {
        display: flex;
        width: max-content;
        animation: marquee-scroll 40s linear infinite;

        @media (prefers-reduced-motion: reduce) {
          animation: none;
        }
      }
    }

    .item {
      display: flex;
      align-items: center;
      white-space: nowrap;
      color: #c1c3c9;

      span {
        font-weight: bold;
        margin-right: 1rem;
        font-size: 1.125rem;
        color: #ffffff;

        &::after {
          content: ":";
        }
      }

      &::after {
        content: "•";
        margin: 0 2rem;
      }
    }
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
