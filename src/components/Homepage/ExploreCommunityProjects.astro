---
import { Icon } from "@astrojs/starlight/components";
import { Image } from "astro:assets";
import { Swiper, SwiperWrapper, SwiperSlide, SwiperPagination } from "astro-swiper";

import espcontrolImg from "../../assets/images/homepage/espcontrol.webp";
import homeAssistantGlowImg from "../../assets/images/homepage/home-assistant-glow.webp";
import airSensorImg from "../../assets/images/homepage/air-sensor.webp";
import weathermanEinkDisplayImg from "../../assets/images/homepage/weatherman-eink-display.webp";
import lowCostSmartDoorbellImg from "../../assets/images/homepage/low-cost-smart-doorbell.webp";
import climateSprinklerControllerImg from "../../assets/images/homepage/climate-sprinkler-controller.webp";

const swiperOptions = {
  slidesPerView: 1.25,
  spaceBetween: 16,
  pagination: {
    clickable: true,
    el: ".explore-community-projects .swiper-pagination",
  },
  breakpoints: {
    768: {
      slidesPerView: 2.25,
    },
    1024: {
      slidesPerView: 3.05,
    },
  },
};
---

<section class="explore-community-projects">
  <div class="container">
    <div class="content-container">
      <h2>Explore what our community is building</h2>
      <p>
        Be inspired by our community’s clever ideas for unique, customized smart home gear – and borrow their recipes
        for your next project.
      </p>
    </div>

    <Swiper class="cards" options={swiperOptions}>
      <SwiperWrapper>
        <SwiperSlide>
          <a
            href="https://jtenniswood.github.io/espcontrol/"
            target="_blank"
            rel="noopener noreferrer"
            class="card card-bgc"
          >
            <div class="card__media">
              <Image src={espcontrolImg} alt="ESPControl" width={330} height={230} />
            </div>
            <div class="card__body">
              <h3 class="card__title">ESPControl</h3>
              <p>
                A simple, web-configurable control panel for your smart home, built with cheap touchscreen displays.
              </p>
              <div class="card__tag-row">
                <span class="card__tag">Display</span>
                <span class="card__tag">Touchscreen</span>
                <span class="card__tag">Dashboard</span>
              </div>
              <span class="sl-link-button not-content primary card__text-link">
                <Icon name="right-arrow" size="1.5rem" />
                View project
              </span>
            </div>
          </a>
        </SwiperSlide>
        <SwiperSlide>
          <a
            href="https://frenck.dev/diy-smart-doorbell-for-just-2-dollar/"
            target="_blank"
            rel="noopener noreferrer"
            class="card card-bgc"
          >
            <div class="card__media">
              <Image src={lowCostSmartDoorbellImg} alt="$2 smart doorbell" width={330} height={230} />
            </div>
            <div class="card__body">
              <h3 class="card__title">$2 Smart Doorbell</h3>
              <p>Turns an ordinary doorbell into a smart notification system for just a couple of dollars in parts.</p>
              <div class="card__tag-row">
                <span class="card__tag">Doorbell</span>
                <span class="card__tag">Notifications</span>
                <span class="card__tag">Budget Build</span>
              </div>
              <span class="sl-link-button not-content primary card__text-link">
                <Icon name="right-arrow" size="1.5rem" />
                View project
              </span>
            </div>
          </a>
        </SwiperSlide>
        <SwiperSlide>
          <a
            href="https://community.home-assistant.io/t/use-esphome-with-e-ink-displays-to-blend-in-with-your-home-decor/435428"
            target="_blank"
            rel="noopener noreferrer"
            class="card card-bgc"
          >
            <div class="card__media">
              <Image src={weathermanEinkDisplayImg} alt="Weatherman e-ink display" width={330} height={230} />
            </div>
            <div class="card__body">
              <h3 class="card__title">Weatherman E-Ink Display</h3>
              <p>An e-ink display that blends into your home decor while showing live data from your smart home.</p>
              <div class="card__tag-row">
                <span class="card__tag">E-Ink</span>
                <span class="card__tag">Display</span>
                <span class="card__tag">Home Decor</span>
              </div>
              <span class="sl-link-button not-content primary card__text-link">
                <Icon name="right-arrow" size="1.5rem" />
                View project
              </span>
            </div>
          </a>
        </SwiperSlide>
        <SwiperSlide>
          <a href="https://youtu.be/DqiMmY5ppnE" target="_blank" rel="noopener noreferrer" class="card card-bgc">
            <div class="card__media">
              <Image src={airSensorImg} alt="FEATURE air quality sensor" width={330} height={230} />
            </div>
            <div class="card__body">
              <h3 class="card__title">FEATURE Air Quality Sensor</h3>
              <p>
                A custom air quality sensor with its own PCB and 3D-printed housing for monitoring the air you breathe
                at home.
              </p>
              <div class="card__tag-row">
                <span class="card__tag">Air Quality</span>
                <span class="card__tag">Sensor</span>
                <span class="card__tag">3D Printed</span>
              </div>
              <span class="sl-link-button not-content primary card__text-link">
                <Icon name="right-arrow" size="1.5rem" />
                View project
              </span>
            </div>
          </a>
        </SwiperSlide>
        <SwiperSlide>
          <a
            href="https://github.com/kbx81/ClimateSprinklerController"
            target="_blank"
            rel="noopener noreferrer"
            class="card card-bgc"
          >
            <div class="card__media">
              <Image src={climateSprinklerControllerImg} alt="Climate Sprinkler Controller" width={330} height={230} />
            </div>
            <div class="card__body">
              <h3 class="card__title">Climate Sprinkler Controller</h3>
              <p>
                A DIY thermostat and sprinkler controller that brings professional-grade climate control to Home
                Assistant.
              </p>
              <div class="card__tag-row">
                <span class="card__tag">Thermostat</span>
                <span class="card__tag">Sprinkler</span>
                <span class="card__tag">Climate Control</span>
              </div>
              <span class="sl-link-button not-content primary card__text-link">
                <Icon name="right-arrow" size="1.5rem" />
                View project
              </span>
            </div>
          </a>
        </SwiperSlide>
        <SwiperSlide>
          <a href="https://glow-energy.io/" target="_blank" rel="noopener noreferrer" class="card card-bgc">
            <div class="card__media">
              <Image src={homeAssistantGlowImg} alt="Home Assistant Glow" width={330} height={230} />
            </div>
            <div class="card__body">
              <h3 class="card__title">Home Assistant Glow energy meter</h3>
              <p>Turns a non-smart energy meter with a pulse output into a fully monitored smart energy sensor.</p>
              <div class="card__tag-row">
                <span class="card__tag">Energy Monitoring</span>
                <span class="card__tag">Sensor</span>
                <span class="card__tag">Pulse Meter</span>
              </div>
              <span class="sl-link-button not-content primary card__text-link">
                <Icon name="right-arrow" size="1.5rem" />
                View project
              </span>
            </div>
          </a>
        </SwiperSlide>
      </SwiperWrapper>
      <SwiperPagination />
    </Swiper>

    <p class="note">
      Browse the <a href="https://devices.esphome.io/">Device List</a> for community-documented devices, or check out <a
        href="https://devices.esphome.io/made-for-esphome/">Made for ESPHome</a
      > certified products built by hardware manufacturers.
    </p>
  </div>
</section>

<style lang="scss">
  @use "../../styles/mixins" as *;

  .explore-community-projects {
    overflow: clip;

    .content-container {
      @include bp(tablet) {
        max-width: 60%;
      }
    }

    :global(.cards) {
      margin-top: 1.5rem;
      padding-bottom: 2.5rem;

      @include bp(desktop) {
        margin-top: 3rem;
      }

      &.swiper {
        overflow: visible;
      }

      :global(.swiper-pagination) {
        bottom: 0;
      }

      :global(.swiper-pagination-bullet) {
        background: var(--esphome-card-background-color);
        opacity: 1;
      }

      :global(.swiper-pagination-bullet-active) {
        background: var(--sl-color-accent);
      }
    }

    :global(.cards:not(.swiper-initialized) .swiper-wrapper) {
      gap: 1rem;
    }

    :global(.cards:not(.swiper-initialized) .swiper-slide) {
      width: 80%;

      @include bp(tablet) {
        width: 44.44%;
      }

      @include bp(desktop) {
        width: 32.79%;
      }
    }

    :global(.cards .swiper-slide) {
      height: auto;
    }

    :global(.card) {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      height: 100%;
      color: inherit;
      text-decoration: none;

      .card__media {
        border-radius: 0.5rem;
        overflow: hidden;
        margin-bottom: 1.5rem;
        width: 100%;

        :global(img) {
          max-height: 100%;
          width: 100%;
          object-fit: cover;
          margin: 0;
        }
      }

      .card__body {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        flex: 1;
        gap: 1rem;
        width: 100%;

        @include bp(desktop) {
          gap: 1.5rem;
        }

        .card__title,
        .card__text-link {
          margin: 0;
        }

        .card__text-link {
          margin-top: auto;
        }
      }
    }

    .note {
      margin-top: 1.5rem;
    }
  }
</style>
