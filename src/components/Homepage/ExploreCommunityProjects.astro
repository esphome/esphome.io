---
import { Icon } from "@astrojs/starlight/components";
import { Image } from "astro:assets";
import { Swiper, SwiperWrapper, SwiperSlide, SwiperPagination } from "astro-swiper";

import kitImg from "../starter-kit/images/esphome-starter-kit.webp";

const swiperOptions = {
  slidesPerView: 1.25,
  spaceBetween: 16,
  pagination: {
    clickable: true,
    el: ".explore-community-projects .swiper-pagination",
  },
  breakpoints: {
    768: {
      slidesPerView: 2.25,
    },
    1024: {
      slidesPerView: 3.05,
    },
  },
};
---

<section class="explore-community-projects">
  <div class="container">
    <div class="content-container">
      <h2>Explore what our community is building</h2>
      <p>
        Be inspired by our community’s clever ideas for unique, customized smart home gear – and borrow their recipes
        for your next project.
      </p>
    </div>

    <Swiper class="cards" options={swiperOptions}>
      <SwiperWrapper>
        <SwiperSlide>
          <a href="/components/#supported-microcontrollers" class="card card-bgc">
            <div class="card__media">
              <Image src={kitImg} alt="ESPHome Starter Kit" width={330} height={230} />
            </div>
            <div class="card__body">
              <span class="card__tag">Community</span>
              <h3 class="card__title">Environment sensor</h3>
              <p>Measure temperature, humidity, and air pressure using a BME280 sensor.</p>
              <div class="card__tag-row">
                <span class="card__tag">Sensor</span>
                <span class="card__tag">ESP32</span>
                <span class="card__tag">Global</span>
              </div>
              <span class="sl-link-button not-content primary card__text-link">
                <Icon name="right-arrow" size="1.5rem" />
                View recipe
              </span>
            </div>
          </a>
        </SwiperSlide>
        <SwiperSlide>
          <a href="/components/#supported-microcontrollers" class="card card-bgc">
            <div class="card__media">
              <Image src={kitImg} alt="ESPHome Starter Kit" width={330} height={230} />
            </div>
            <div class="card__body">
              <span class="card__tag">Community</span>
              <h3 class="card__title">Environment sensor</h3>
              <p>Measure temperature, humidity, and air pressure using a BME280 sensor.</p>
              <div class="card__tag-row">
                <span class="card__tag">Sensor</span>
                <span class="card__tag">ESP32</span>
                <span class="card__tag">Global</span>
              </div>
              <span class="sl-link-button not-content primary card__text-link">
                <Icon name="right-arrow" size="1.5rem" />
                View recipe
              </span>
            </div>
          </a>
        </SwiperSlide>
        <SwiperSlide>
          <a href="/components/#supported-microcontrollers" class="card card-bgc">
            <div class="card__media">
              <Image src={kitImg} alt="ESPHome Starter Kit" width={330} height={230} />
            </div>
            <div class="card__body">
              <span class="card__tag">Community</span>
              <h3 class="card__title">Environment sensor</h3>
              <p>Measure temperature, humidity, and air pressure using a BME280 sensor.</p>
              <div class="card__tag-row">
                <span class="card__tag">Sensor</span>
                <span class="card__tag">ESP32</span>
                <span class="card__tag">Global</span>
              </div>
              <span class="sl-link-button not-content primary card__text-link">
                <Icon name="right-arrow" size="1.5rem" />
                View recipe
              </span>
            </div>
          </a>
        </SwiperSlide>
        <SwiperSlide>
          <a href="/components/#supported-microcontrollers" class="card card-bgc">
            <div class="card__media">
              <Image src={kitImg} alt="ESPHome Starter Kit" width={330} height={230} />
            </div>
            <div class="card__body">
              <span class="card__tag">Community</span>
              <h3 class="card__title">Environment sensor</h3>
              <p>Measure temperature, humidity, and air pressure using a BME280 sensor.</p>
              <div class="card__tag-row">
                <span class="card__tag">Sensor</span>
                <span class="card__tag">ESP32</span>
                <span class="card__tag">Global</span>
              </div>
              <span class="sl-link-button not-content primary card__text-link">
                <Icon name="right-arrow" size="1.5rem" />
                View recipe
              </span>
            </div>
          </a>
        </SwiperSlide>
        <SwiperSlide>
          <a href="/components/#supported-microcontrollers" class="card card-bgc">
            <div class="card__media">
              <Image src={kitImg} alt="ESPHome Starter Kit" width={330} height={230} />
            </div>
            <div class="card__body">
              <span class="card__tag">Community</span>
              <h3 class="card__title">Environment sensor</h3>
              <p>Measure temperature, humidity, and air pressure using a BME280 sensor.</p>
              <div class="card__tag-row">
                <span class="card__tag">Sensor</span>
                <span class="card__tag">ESP32</span>
                <span class="card__tag">Global</span>
              </div>
              <span class="sl-link-button not-content primary card__text-link">
                <Icon name="right-arrow" size="1.5rem" />
                View recipe
              </span>
            </div>
          </a>
        </SwiperSlide>
      </SwiperWrapper>
      <SwiperPagination />
    </Swiper>

    <p class="note">
      Browse the <a href="https://devices.esphome.io/">Device List</a> for community-documented devices, or check out <a
        href="/guides/made_for_esphome/">Made for ESPHome</a
      > certified products built by hardware manufacturers.
    </p>
  </div>
</section>

<style lang="scss">
  @use "../../styles/mixins" as *;

  .explore-community-projects {
    overflow: clip;

    .content-container {
      @include bp(tablet) {
        max-width: 60%;
      }
    }

    :global(.cards) {
      margin-top: 1.5rem;
      padding-bottom: 2.5rem;

      @include bp(desktop) {
        margin-top: 3rem;
      }

      &.swiper {
        overflow: visible;
      }

      :global(.swiper-pagination) {
        bottom: 0;
      }

      :global(.swiper-pagination-bullet) {
        background: var(--sl-color-gray-3);
        opacity: 1;
      }

      :global(.swiper-pagination-bullet-active) {
        background: var(--sl-color-accent);
      }
    }

    // Reserve slide width up front so the layout matches the desktop `slidesPerView` from the
    // moment the page paints, instead of jumping to it once swiper's JS initializes.
    :global(.cards:not(.swiper-initialized) .swiper-wrapper) {
      gap: 1rem;
    }

    :global(.cards:not(.swiper-initialized) .swiper-slide) {
      width: 80%;

      @include bp(tablet) {
        width: 44.44%;
      }

      @include bp(desktop) {
        width: 32.79%;
      }
    }

    :global(.card) {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      height: auto;
      color: inherit;
      text-decoration: none;

      .card__media {
        border-radius: 0.5rem;
        overflow: hidden;
        margin-bottom: 1.5rem;
        width: 100%;

        :global(img) {
          max-height: 100%;
          width: 100%;
          object-fit: cover;
          margin: 0;
        }
      }

      .card__body {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1.5rem;
        width: 100%;

        .card__title,
        .card__text-link {
          margin: 0;
        }
      }
    }

    .note {
      margin-top: 1.5rem;
    }
  }
</style>
