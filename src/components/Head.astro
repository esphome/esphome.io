---
import Default from "@astrojs/starlight/components/Head.astro";
---

<Default {...Astro.props}><slot /></Default>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    document.querySelector("a.site-title")?.addEventListener("contextmenu", (e) => {
      e.preventDefault();
      window.open("https://media.esphome.io/logo/", "_blank", "noopener,noreferrer");
    });
  });
</script>

<!-- prettier-ignore -->
<script is:inline async src="https://plausible.openhomefoundation.org/js/pa-IT3qGllOk_UiNLNNQsPlX.js"></script><script
  is:inline
>
  ((window.plausible =
    window.plausible ||
    function () {
      (plausible.q = plausible.q || []).push(arguments);
    }),
    (plausible.init =
      plausible.init ||
      function (i) {
        plausible.o = i || {};
      }));
  plausible.init();
</script>
