---
import Default from "@astrojs/starlight/components/Head.astro";
---

<Default {...Astro.props}><slot /></Default>

<script>
  document
    .querySelector("a.site-title")
    ?.addEventListener("contextmenu", (e) => {
      e.preventDefault();
      window.open("https://media.esphome.io/logo/", "_blank");
    });
</script>
