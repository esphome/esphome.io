---
import CardGroup from "@components/CardGroup.astro";

import Card from "@components/Card.astro";
import IconText from "@components/IconText.astro";
import IconTextGroup from "@components/IconTextGroup.astro";

import TitleText from "@components/starter-kit/TitleText.astro";
---

<section class="block-your-way">
  <TitleText>
    <h2 slot="title" class="title">Your smart home, your way</h2>
    <p slot="text">
      The ESPHome Starter Kit equips you with the tools, skills and confidence
      to stop just using smart home tech and start creating it, in three simple
      steps: Build. Learn. Automate.
    </p>
  </TitleText>

  <CardGroup columns={3}>
    <Card>
      <IconText icon="usbc_cable" />
      <h3>Build.</h3>
      <p>
        Go straight to the fun part with foolproof, solder-free assembly –
        everything works out of the box via an easy plug-and-play system.
      </p>
    </Card>
    <Card>
      <IconText icon="book" />
      <h3>Learn.</h3>
      <p>
        Real skills, not shortcuts: we simplify getting started, but you'll gain
        knowledge to tackle more complex projects like ESPHome.
      </p>
    </Card>
    <Card>
      <IconText icon="setting" />
      <h3>Automate.</h3>
      <p>
        Integrates easy to add to your existing smart setup, giving you freedom
        to create custom devices to suit your home and lifestyle.
      </p>
    </Card>
  </CardGroup>
</section>

<style lang="scss"></style>
