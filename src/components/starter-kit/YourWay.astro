---
import Card from "@components/Card.astro";
import IconText from "@components/IconText.astro";
import IconTextGroup from "@components/IconTextGroup.astro";
---

<section class="block-your-way">
  <Card>
    <IconText icon="usbc_cable" />
    <h3>Build.</h3>
    <p>
      Go straight to the fun part with foolproof, solder-free assembly –
      everything works out of the box via an easy plug-and-play system.
    </p>
  </Card>
  <Card>
    <IconText icon="book" />
    <h3>Learn.</h3>
    <p>
      Real skills, not shortcuts: we simplify getting started, but you'll gain
      knowledge to tackle more complex projects like ESPHome.
    </p>
  </Card>
  <Card>
    <IconText icon="setting" />
    <h3>Automate.</h3>
    <p>
      Integrates easy to add to your existing smart setup, giving you freedom to
      create custom devices to suit your home and lifestyle.
    </p>
  </Card>

  <Card>
    <IconTextGroup>
      <IconText icon="button" text="Click a button" />
      <IconText icon="music" text="Play music" />
    </IconTextGroup>
    <h3>Automate.</h3>
    <p>
      Integrates easy to add to your existing smart setup, giving you freedom to
      create custom devices to suit your home and lifestyle.
    </p>
  </Card>
</section>

<script></script>

