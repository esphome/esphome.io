---
import { Image } from "astro:assets";

import Gallery from "@components/Gallery.astro";
import GalleryItem from "@components/GalleryItem.astro";

import kitImg from "./images/esphome-starter-kit.webp";
import kitAndStandImg from "./images/esphome-starter-kit-and-stand.webp";
import whatsInTheBoxImg from "./images/esphome-starter-kit-whats-in-the-box.webp";
---

<section class="block-gallery">
  <Gallery columns={2} rows={2}>
    <GalleryItem rowSpan={2}>
      <Image src={kitImg} alt="ESPHome Starter Kit with snap mounts attached" />
      <video id="disassembly-video" class="lazy-video" muted playsinline preload="metadata">
        <source src="/videos/starter-kit/kit-disassembly.mp4" type="video/mp4" />
      </video>
      <button class="play-button" data-video-id="disassembly-video" aria-label="Play disassembly video"></button>
    </GalleryItem>
    <GalleryItem>
      <Image src={kitAndStandImg} alt="ESPHome Starter Kit with button module and stand" />
    </GalleryItem>
    <GalleryItem>
      <Image src={whatsInTheBoxImg} alt="ESPHome Starter Kit box contents" />
    </GalleryItem>
  </Gallery>
</section>
