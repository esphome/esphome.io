<script is:inline>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var enabled =
      params.get("debug") === "console" ||
      window.localStorage.getItem("esk-debug-console") === "1";

    if (!enabled) return;

    window.localStorage.setItem("esk-debug-console", "1");

    var log = [];
    var textarea = null;

    function timestamp() {
      var d = new Date();
      return [d.getHours(), d.getMinutes(), d.getSeconds()]
        .map(function (n) {
          return String(n).padStart(2, "0");
        })
        .join(":");
    }

    function formatArg(arg) {
      if (arg instanceof Error) return arg.stack || arg.message;
      if (typeof arg === "object" && arg !== null) {
        try {
          return JSON.stringify(arg);
        } catch (e) {
          return String(arg);
        }
      }
      return String(arg);
    }

    function record(level, args) {
      var message = Array.prototype.map.call(args, formatArg).join(" ");
      log.push("[" + timestamp() + "] " + level + ": " + message);
      render();
    }

    var originalWarn = console.warn.bind(console);
    var originalError = console.error.bind(console);

    console.warn = function () {
      record("WARN", arguments);
      originalWarn.apply(console, arguments);
    };

    console.error = function () {
      record("ERROR", arguments);
      originalError.apply(console, arguments);
    };

    // Registered here (classic, non-deferred script) so it's active before
    // Hero's module script runs, catching synchronous throws (e.g. WebGL
    // context creation failures) that never reach a try/catch there.
    window.addEventListener("error", function (event) {
      var detail =
        event.error && event.error.stack
          ? event.error.stack
          : event.message +
            " (" +
            event.filename +
            ":" +
            event.lineno +
            ":" +
            event.colno +
            ")";
      record("UNCAUGHT", [detail]);
    });

    window.addEventListener("unhandledrejection", function (event) {
      record("REJECTION", [formatArg(event.reason)]);
    });

    function ensureUI() {
      if (textarea || !document.body) return;

      var wrapper = document.createElement("div");
      wrapper.id = "esk-debug-console";
      wrapper.style.cssText =
        "position:fixed;left:0;right:0;bottom:0;z-index:999999;" +
        "background:rgba(0,0,0,0.9);padding:8px;box-sizing:border-box;" +
        "font-family:monospace;";

      var header = document.createElement("div");
      header.style.cssText =
        "display:flex;justify-content:space-between;align-items:center;" +
        "margin-bottom:4px;color:#fff;font-size:12px;";
      header.innerHTML = "<strong>Debug Console</strong>";

      var buttons = document.createElement("div");

      var copyButton = document.createElement("button");
      copyButton.type = "button";
      copyButton.textContent = "Copy";
      copyButton.style.cssText =
        "background:#333;color:#fff;border:none;padding:4px 8px;" +
        "margin-right:4px;cursor:pointer;";
      copyButton.addEventListener("click", function () {
        navigator.clipboard?.writeText(textarea.value);
      });

      var closeButton = document.createElement("button");
      closeButton.type = "button";
      closeButton.textContent = "Close";
      closeButton.style.cssText =
        "background:#333;color:#fff;border:none;padding:4px 8px;cursor:pointer;";
      closeButton.addEventListener("click", function () {
        wrapper.remove();
        window.localStorage.removeItem("esk-debug-console");
      });

      buttons.appendChild(copyButton);
      buttons.appendChild(closeButton);
      header.appendChild(buttons);

      textarea = document.createElement("textarea");
      textarea.readOnly = true;
      textarea.style.cssText =
        "width:100%;height:160px;background:#000;color:#0f0;" +
        "font:11px/1.4 monospace;border:1px solid #444;resize:vertical;";

      wrapper.appendChild(header);
      wrapper.appendChild(textarea);
      document.body.appendChild(wrapper);
    }

    function render() {
      ensureUI();
      if (!textarea) return;
      textarea.value = log.join("\n");
      textarea.scrollTop = textarea.scrollHeight;
    }

    if (document.body) {
      ensureUI();
    } else {
      document.addEventListener("DOMContentLoaded", ensureUI);
    }

    render();
  })();
</script>
