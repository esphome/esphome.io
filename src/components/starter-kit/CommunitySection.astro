---
import CardGroup from "@components/CardGroup.astro";
import Card from "@components/Card.astro";
import IconText from "@components/IconText.astro";
import TitleText from "@components/starter-kit/TitleText.astro";

interface CommunityLink {
  title: string;
  description: string;
  href: string;
  icon?: "printable" | "discord" | "forum";
  delay?: number;
}

const links: CommunityLink[] = [
  {
    title: "3D printables",
    description:
      "Community-designed enclosures, stands and mounts for every module which are ready to print and remix.",
    href: "https://wiki.apolloautomation.com/products/ESPHome-Starter-Kit/community-corner/#3d-prints",
    icon: "printable",
    delay: 0,
  },
  {
    title: "Join our Discord",
    description:
      "Show off your build, get real-time help, and connect with other ESPHome makers.",
    href: "https://discord.gg/KhAMKrd",
    icon: "discord",
    delay: 150,
  },
  {
    title: "Community Forum",
    description:
      "Post your project, whether that's a 3D-printed case, a clever automation, or a wild use case, and get featured in front of the whole community.",
    href: "https://forum.apolloautomation.com/c/esphome-starter-kit/",
    icon: "forum",
    delay: 300,
  },
];
---

<section id="community" class="block-community">
  <TitleText>
    <h2 slot="title" class="title">Built with the community</h2>
    <p slot="text">
      The Starter Kit is just the starting point. Tap into a community of makers
      already designing cases, sharing configurations, and remixing the kit into
      projects of their own.
    </p>
  </TitleText>

  <CardGroup columns={3}>
    {
      links.map((link) => (
        <Card
          href={link.href}
          rel="noopener noreferrer"
          target="_blank"
          data-delay={link.delay}
        >
          {link.icon && <IconText icon={link.icon} />}
          <h3>{link.title}</h3>
          <p>{link.description}</p>
        </Card>
      ))
    }
  </CardGroup>
</section>

<style lang="scss">
  @use "../../styles/mixins" as *;

  .block-community {
    :global(.card__arrow) {
      @include fluid(16, 32, $property: top);
      @include fluid(16, 32, $property: right);
    }
  }
</style>
