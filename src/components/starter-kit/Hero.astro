<section class="block-hero">
  <canvas id="scene"></canvas>
  <div class="container">
    <div class="block-hero__content-container">
      <div class="block-hero__content">
        <h1><strong>ESPHome</strong> Starter Kit</h1>
        <p class="subtitle">BUILD. LEARN. AUTOMATE.</p>
        <p>The easiest path to building your own smart home devices</p>

        <div class="collaboration-badge">
          <span>Designed and built by</span>
          <div class="collaborators">
            <div class="collaborator">
              <img
                src="/images/collaboration/apollo-automation.svg"
                alt="Apollo Automation Logo"
              />
            </div>
            <div class="collaborator">
              <img
                src="/images/collaboration/open-home-foundation.svg"
                alt="Open Home Foundation Logo"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
  import Stats from "three/addons/libs/stats.module.js";

  const DEBUG_ORBIT = true;
  import gsap from "gsap";

  const canvas = document.getElementById("scene");
  const width = canvas.clientWidth;
  const height = canvas.clientHeight;

  const camera = new THREE.PerspectiveCamera(70, width / height, 0.05, 1000);
  camera.position.set(0, 0, 1);

  const controls = new OrbitControls(camera, canvas);
  controls.enableDamping = true;
  controls.enabled = DEBUG_ORBIT;
  controls.enableZoom = false; // Disables zooming with the mouse wheel or pinch gestures

  const scene = new THREE.Scene();

  const ambientLight = new THREE.AmbientLight(0xffffff, 0.5); // 1.5 / 0.5
  scene.add(ambientLight);

  const directionalLight = new THREE.DirectionalLight(0xffffff, 1.5);
  directionalLight.position.set(1, 1, 1);
  scene.add(directionalLight);
  scene.add(new THREE.DirectionalLightHelper(directionalLight, 0.2));

  scene.add(new THREE.AxesHelper(5));
  scene.add(new THREE.GridHelper(10, 10));

  const lightHelpers: THREE.Object3D[] = [];

  const scrollDemoModel = "/starter-kit/esphome-starter-kit-alt-light.glb";

  const loader = new GLTFLoader();
  loader.load(scrollDemoModel + "?" + Date.now(), (gltf) => {
    const modelScaleMult = 10;

    console.log("GLTF loaded:", gltf);

    const model = gltf.scene;
    model.scale.set(modelScaleMult, modelScaleMult, modelScaleMult);
    scene.add(model);

    // Force world matrix update so bounding boxes are correct
    model.updateWorldMatrix(true, true);

    // Clone materials and enable transparency on all meshes
    const allMeshes = [];
    model.traverse((child) => {
      if (child.isMesh) {
        child.material = child.material.clone();
        child.material.transparent = true;
        allMeshes.push(child);

        console.log(`Mesh: ${child.name}`); // Debug
      }

      if (child.isLight) {
        console.log(child);

        child.intensity = 1000;

        let helper;
        if (child.isPointLight) {
          helper = new THREE.PointLightHelper(child, 0.5, 0xffff00);
        } else if (child.isSpotLight) {
          helper = new THREE.SpotLightHelper(child, 0xffff00);
        } else if (child.isDirectionalLight) {
          helper = new THREE.DirectionalLightHelper(child, 0.5, 0xffff00);
        }
        if (helper) {
          scene.add(helper);
          lightHelpers.push(helper);
        }
        console.log(
          `Light: ${child.name} (${child.type}) intensity=${child.intensity}`,
        );
      }
    });

    // Store initial camera state for hero restore
    const initialCameraPos = camera.position.clone();
    const initialTarget = controls.target.clone();

    /**
     * Restores camera and mesh states to show the full model
     */
    function restoreHero() {
      controls.enabled = DEBUG_ORBIT;

      gsap.to(camera.position, {
        x: initialCameraPos.x,
        y: initialCameraPos.y,
        z: initialCameraPos.z,
        duration: 1,
        ease: "power2.inOut",
      });

      gsap.to(controls.target, {
        x: initialTarget.x,
        y: initialTarget.y,
        z: initialTarget.z,
        duration: 1,
        ease: "power2.inOut",
      });

      allMeshes.forEach((mesh) => {
        gsap.to(mesh.material, { opacity: 1, duration: 0.6 });
        mesh.material.depthWrite = true; // Restore depth writing for all meshes
      });
    }

    /**
     * Focuses the camera on a specific group of meshes
     * @param group Array of mesh names to focus on
     * @param center Center position of the group
     * @param camOffset Camera offset from the center
     */
    function focusMesh(group, center, camOffset) {
      // controls.enabled = false;

      gsap.to(camera.position, {
        x: camOffset.x,
        y: camOffset.y,
        z: camOffset.z,
        duration: 1,
        ease: "power2.inOut",
      });

      gsap.to(controls.target, {
        x: center.x,
        y: center.y,
        z: center.z,
        duration: 1,
        ease: "power2.inOut",
      });

      allMeshes.forEach((mesh) => {
        const isTarget = group.includes(mesh.name);
        gsap.to(mesh.material, {
          opacity: isTarget ? 1 : 0.1,
          duration: 0.6,
        });

        mesh.material.depthWrite = isTarget; // Prevent transparent meshes from occluding targets
      });
    }
  });

  const stats = new Stats();
  document.body.appendChild(stats.dom);
  stats.domElement.style.top = "auto";
  stats.domElement.style.bottom = 0;

  const renderer = new THREE.WebGLRenderer({
    canvas,
    antialias: true,
    transparent: true,
    preserveDrawingBuffer: false,
    toneMapping: THREE.ACESFilmicToneMapping,
    toneMappingExposure: 1.2,
    outputColorSpace: THREE.SRGBColorSpace,
    outputEncoding: THREE.sRGBEncoding,
    // alpha: true,
  });

  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(width, height);
  renderer.setAnimationLoop(animate);
  // renderer.setClearColor(0x000000, 0); // Set background to transparent

  function animate() {
    stats.begin();
    controls.update();
    lightHelpers.forEach((h: any) => h.update && h.update());
    renderer.render(scene, camera);
    stats.end();
  }

  function resize() {
    const width = canvas.clientWidth;
    const height = canvas.clientHeight;
    if (canvas.width !== width || canvas.height !== height) {
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    }
  }
  window.addEventListener("resize", () => resize());
</script>

