<section class="block-hero">
  <div class="container">
    <div class="block-hero__content-container">
      <div class="block-hero__content">
        <h1><strong>ESPHome</strong> Starter Kit</h1>
        <p class="subtitle">BUILD. LEARN. AUTOMATE.</p>
        <p>The easiest path to building your own smart home devices</p>

        <div class="collaboration-badge">
          <span>Designed and built by</span>
          <div class="collaborators">
            <div class="collaborator">
              <img
                src="/images/collaboration/apollo-automation.svg"
                alt="Apollo Automation Logo"
              />
            </div>
            <div class="collaborator">
              <img
                src="/images/collaboration/open-home-foundation.svg"
                alt="Open Home Foundation Logo"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="block-hero__asset-container">
      <model-viewer
        src="/starter-kit/combined-panel-compute-optimised.glb"
        alt="ESPHome Starter Kit 3D model"
        ar
        ar-modes="webxr scene-viewer quick-look"
        ar-scale="fixed"
        camera-controls
        disable-zoom
        disable-pan
        disable-tap
        touch-action="pan-y"
        min-camera-orbit="auto auto 0m"
        interaction-prompt-threshold="6000"
        interpolation-decay="80"
        tone-mapping="aces"
        poster="/starter-kit/poster.webp"
        shadow-intensity="0"
      >
        <button
          class="hotspot"
          slot="hotspot-1"
          data-position="-0.5605654272973684m 2.3497694925085417m 0.1577726669933136m"
          data-normal="0m -4.7181972549813103e-7m 0.9999999999998889m"
          data-visibility-attribute="visible"
          aria-label="Button module"></button>
        <button
          class="hotspot"
          slot="hotspot-2"
          data-position="0.06594962962506401m 2.505031394564349m 0.04108281874086464m"
          data-normal="0m -3.021140994925911e-7m 0.9999999999999545m"
          data-visibility-attribute="visible"
          aria-label="Temp & hum module"></button>
        <button
          class="hotspot"
          slot="hotspot-3"
          data-position="0.6767021090234897m 2.551928830256844m 0.10511088381804498m"
          data-normal="-7.549788288176731e-8m 1.352368577797927e-7m 0.999999999999988m"
          data-visibility-attribute="visible"
          aria-label="Motion module"></button>
        <button
          class="hotspot"
          slot="hotspot-4"
          data-position="0.03080501274970332m 1.3308043464158432m 0.0410827821529187m"
          data-normal="0m -6.28895230895957e-8m 0.999999999999998m"
          data-visibility-attribute="visible"
          aria-label="LED & buzzer module"></button>
        <button
          class="hotspot"
          slot="hotspot-5"
          data-position="-0.2379975457681977m 0.06684272313252704m 0.10484313944579174m"
          data-normal="0m -6.74608119632293e-8m 0.9999999999999979m"
          data-visibility-attribute="visible"
          aria-label="ESP32 Microcontroller"></button>

        <svg
          class="hotspot-lines"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <line class="hotspot-line" data-hotspot="hotspot-1"></line>
          <line class="hotspot-line" data-hotspot="hotspot-2"></line>
          <line class="hotspot-line" data-hotspot="hotspot-3"></line>
          <line class="hotspot-line" data-hotspot="hotspot-4"></line>
          <line class="hotspot-line" data-hotspot="hotspot-5"></line>
        </svg>

        <!--
          Each label is anchored at data-position (world coords).
          Editing axes (default camera angle):
            • Y up  = label moves UP on screen
            • X right = label moves RIGHT on screen
            • Z (0.1m ≈ panel surface) — keep near 0.1 unless you want parallax
          Modules sit at:
            button (-0.56, 2.35), temp (0.07, 2.50), motion (0.68, 2.55),
            led (0.03, 1.33), esp32 (-0.24, 0.07)
        -->
        <button
          class="hotspot-label"
          slot="hotspot-label-1"
          data-position="-0.8m 2.4m 0m"
          data-normal="0m 0m 1m"
          data-visibility-attribute="visible"
          data-hotspot="hotspot-1"
          data-zoom="1.8m"
        >
          Button module
        </button>
        <button
          class="hotspot-label"
          slot="hotspot-label-2"
          data-position="0.07m 2.8m 0.1m"
          data-normal="0m 0m 1m"
          data-visibility-attribute="visible"
          data-hotspot="hotspot-2"
          data-zoom="1.5m"
        >
          Temp & hum module
        </button>
        <button
          class="hotspot-label"
          slot="hotspot-label-3"
          data-position="0.9m 2.8m 0.1m"
          data-normal="0m 0m 1m"
          data-visibility-attribute="visible"
          data-hotspot="hotspot-3"
          data-zoom="1.8m"
        >
          Motion module
        </button>
        <button
          class="hotspot-label"
          slot="hotspot-label-4"
          data-position="0.8m 1.8m 0.1m"
          data-normal="0m 0m 1m"
          data-visibility-attribute="visible"
          data-hotspot="hotspot-4"
          data-zoom="3.8m"
        >
          LED & buzzer module
        </button>
        <button
          class="hotspot-label"
          slot="hotspot-label-5"
          data-position="-0.5m 0.25m 0.1m"
          data-normal="0m 0m 1m"
          data-visibility-attribute="visible"
          data-hotspot="hotspot-5"
          data-zoom="4m"
        >
          ESP32 Microcontroller
        </button>
      </model-viewer>
      <button type="button" class="block-hero__close" aria-label="Reset view">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            d="M6 6L18 18M6 18L18 6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<script is:inline type="module" src="/vendor/model-viewer/model-viewer.min.js"
></script>

<script is:inline type="module">
  await customElements.whenDefined("model-viewer");
  customElements.get("model-viewer").meshoptDecoderLocation =
    "/vendor/model-viewer/meshopt_decoder.module.js";

  try {
    const PROMPT_KEY = "esk-hero-prompt-views";
    const seen = Number(localStorage.getItem(PROMPT_KEY) ?? 0);
    if (seen >= 3) {
      document
        .querySelector(".block-hero model-viewer")
        ?.setAttribute("interaction-prompt", "none");
    } else {
      localStorage.setItem(PROMPT_KEY, String(seen + 1));
    }
  } catch {
    // localStorage blocked (private mode, etc.) — leave the prompt on
  }
</script>

<script>
  const assetContainer = document.querySelector<HTMLElement>(
    ".block-hero__asset-container",
  );
  const mv = assetContainer?.querySelector("model-viewer") as any;
  const closeBtn =
    assetContainer?.querySelector<HTMLButtonElement>(".block-hero__close");
  const hotspots =
    assetContainer?.querySelectorAll<HTMLElement>(".hotspot") ?? [];
  const labels =
    assetContainer?.querySelectorAll<HTMLElement>(".hotspot-label") ?? [];
  const lines =
    assetContainer?.querySelectorAll<SVGLineElement>(".hotspot-line") ?? [];

  const labelByDotSlot = new Map<string, HTMLElement>();
  labels.forEach((l) => {
    const dotSlot = l.dataset.hotspot;
    if (dotSlot) labelByDotSlot.set(dotSlot, l);
  });

  const clearActive = () => {
    hotspots.forEach((h) => h.classList.remove("is-active"));
    labels.forEach((l) => l.classList.remove("is-active"));
    lines.forEach((l) => l.classList.remove("is-active"));
  };

  const IDLE_RESET_MS = 15000;
  let idleTimer: number | undefined;

  const scheduleIdleReset = () => {
    if (idleTimer !== undefined) clearTimeout(idleTimer);
    idleTimer = window.setTimeout(() => {
      if (assetContainer?.classList.contains("is-zoomed")) resetView();
    }, IDLE_RESET_MS);
  };

  const resetView = () => {
    if (!mv) return;
    mv.cameraTarget = "auto";
    mv.cameraOrbit = "auto auto auto";
    assetContainer?.classList.remove("is-zoomed");
    clearActive();
    if (idleTimer !== undefined) {
      clearTimeout(idleTimer);
      idleTimer = undefined;
    }
  };

  const DEFAULT_ZOOM = "1.5m";
  // Fixed "front view" angle for all hotspot zooms. All modules are on the
  // same face of the panel, so they share a target viewing angle.
  const ZOOM_THETA = "0deg";
  const ZOOM_PHI = "75deg";

  const parseTriplet = (s: string | undefined): [number, number, number] => {
    if (!s) return [0, 0, 1];
    const parts = s.split(/\s+/).map((p) => parseFloat(p));
    return [parts[0] ?? 0, parts[1] ?? 0, parts[2] ?? 1];
  };

  const zoomTo = (slot: string | undefined) => {
    if (!mv || !slot) return;
    const hotspot = mv.querySelector(`.hotspot[slot="${slot}"]`);
    if (!hotspot) return;
    const label = assetContainer?.querySelector<HTMLElement>(
      `.hotspot-label[data-hotspot="${slot}"]`,
    );
    const zoom = label?.dataset.zoom ?? DEFAULT_ZOOM;
    mv.cameraTarget = hotspot.dataset.position;
    mv.cameraOrbit = `${ZOOM_THETA} ${ZOOM_PHI} ${zoom}`;
    assetContainer?.classList.add("is-zoomed");
    clearActive();
    hotspot.classList.add("is-active");
    label?.classList.add("is-active");
    assetContainer
      ?.querySelector(`.hotspot-line[data-hotspot="${slot}"]`)
      ?.classList.add("is-active");
    scheduleIdleReset();
  };

  hotspots.forEach((h) =>
    h.addEventListener("click", () =>
      zoomTo(h.getAttribute("slot") ?? undefined),
    ),
  );
  labels.forEach((l) =>
    l.addEventListener("click", () => zoomTo(l.dataset.hotspot)),
  );
  closeBtn?.addEventListener("click", resetView);

  mv?.addEventListener("camera-change", scheduleIdleReset);

  // ── Click-on-mesh + click-outside-to-close ─────────────────────────────
  // We listen for click (vs pointerup) so the browser's own click-vs-drag
  // arbitration kicks in. We also track pointer travel distance ourselves
  // as a backstop: any movement > 6px between down and up disqualifies
  // the click from triggering a zoom/dismiss.

  const HOTSPOT_PICK_RADIUS = 1.2; // metres
  const DRAG_THRESHOLD = 6; // pixels

  const hotspotPositions: { slot: string; x: number; y: number; z: number }[] =
    [];
  hotspots.forEach((h) => {
    const slot = h.getAttribute("slot");
    if (!slot) return;
    const [x, y, z] = parseTriplet(h.dataset.position);
    hotspotPositions.push({ slot, x, y, z });
  });

  const findNearestHotspot = (p: {
    x: number;
    y: number;
    z: number;
  }): string | null => {
    let bestSlot: string | null = null;
    let bestDist2 = HOTSPOT_PICK_RADIUS * HOTSPOT_PICK_RADIUS;
    for (const hp of hotspotPositions) {
      const dx = hp.x - p.x;
      const dy = hp.y - p.y;
      const dz = hp.z - p.z;
      const d2 = dx * dx + dy * dy + dz * dz;
      if (d2 < bestDist2) {
        bestDist2 = d2;
        bestSlot = hp.slot;
      }
    }
    return bestSlot;
  };

  let pointerDownX = 0;
  let pointerDownY = 0;
  let pointerMaxDistance = 0;

  mv?.addEventListener("pointerdown", (e: PointerEvent) => {
    pointerDownX = e.clientX;
    pointerDownY = e.clientY;
    pointerMaxDistance = 0;
  });

  mv?.addEventListener("pointermove", (e: PointerEvent) => {
    const dx = e.clientX - pointerDownX;
    const dy = e.clientY - pointerDownY;
    const d = Math.hypot(dx, dy);
    if (d > pointerMaxDistance) pointerMaxDistance = d;
  });

  mv?.addEventListener("click", async (e: MouseEvent) => {
    const wasDrag = pointerMaxDistance > DRAG_THRESHOLD;
    pointerMaxDistance = 0;
    if (wasDrag) return;

    const target = e.target as HTMLElement | null;
    // Dot / label / close-button clicks already have their own handlers
    if (target?.closest(".hotspot, .hotspot-label, .block-hero__close")) return;

    // Try to pick a module under the click
    const hit = await mv.positionAndNormalFromPoint(e.clientX, e.clientY);
    if (hit?.position) {
      const slot = findNearestHotspot(hit.position);
      if (slot) {
        zoomTo(slot);
        return;
      }
    }

    // No module hit — if currently zoomed, dismiss
    if (assetContainer?.classList.contains("is-zoomed")) resetView();
  });

  const svg = assetContainer?.querySelector<SVGSVGElement>(".hotspot-lines");

  let mvOffsetX = 0;
  let mvOffsetY = 0;

  const refreshGeometry = () => {
    if (!mv || !svg) return;
    const mvRect = mv.getBoundingClientRect();
    const svgRect = svg.getBoundingClientRect();
    mvOffsetX = mvRect.left - svgRect.left;
    mvOffsetY = mvRect.top - svgRect.top;
  };

  const drawLines = () => {
    if (!mv) return;
    for (const line of lines) {
      const dotSlot = line.dataset.hotspot;
      if (!dotSlot) continue;
      const labelSlot = dotSlot.replace("hotspot-", "hotspot-label-");
      const dot = mv.queryHotspot(dotSlot);
      const label = mv.queryHotspot(labelSlot);
      if (!dot || !label) continue;
      const labelEl = labelByDotSlot.get(dotSlot);
      const occluded = labelEl ? !labelEl.hasAttribute("data-visible") : false;
      line.classList.toggle("is-occluded", occluded);
      line.setAttribute("x1", String(dot.canvasPosition.x + mvOffsetX));
      line.setAttribute("y1", String(dot.canvasPosition.y + mvOffsetY));
      line.setAttribute("x2", String(label.canvasPosition.x + mvOffsetX));
      line.setAttribute("y2", String(label.canvasPosition.y + mvOffsetY));
    }
    requestAnimationFrame(drawLines);
  };

  let resizeTimer: number | undefined;
  const onResize = () => {
    if (resizeTimer !== undefined) clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(refreshGeometry, 150);
  };
  window.addEventListener("resize", onResize, { passive: true });

  mv?.addEventListener("load", () => {
    refreshGeometry();
    requestAnimationFrame(drawLines);
    assetContainer?.classList.add("is-loaded");
  });
</script>

<style lang="scss">
  @use "../../styles/mixins" as *;

  .block-hero {
    min-height: 600px;
    margin: 0;
    position: relative;
    padding-top: 8.75rem;

    display: flex;
    align-items: stretch;

    @include bp(tablet) {
      height: calc(100vh - var(--sl-nav-height));
    }

    .container {
      flex-direction: column;
      gap: 2rem;

      @include bp(tablet) {
        flex-direction: row;
      }
    }

    &__content-container,
    &__asset-container {
      width: 100%;
      display: flex;
      align-items: center;
      position: relative;
      margin: 0;
      z-index: 5;
    }

    &__asset-container {
      height: 100%;
      min-height: clamp(440px, 60vh, 720px);
      user-select: none;
      -webkit-user-select: none;
      overflow: visible;

      display: flex;

      model-viewer {
        width: 100%;
        height: 100%;
        min-height: clamp(440px, 60vh, 720px);
        overflow: visible;
      }

      &.is-zoomed {
        .block-hero__close {
          opacity: 1;
          pointer-events: auto;
        }

        .hotspot:not(.is-active) {
          opacity: 0;
          pointer-events: none;
        }
      }
    }

    &__close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--esk-primary-color);
      backdrop-filter: blur(6px);
      border: none;
      color: #fff;
      cursor: pointer;
      z-index: 10;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;

      &:hover {
        background: var(--esk-primary-color--light);
        color: #000;
      }
    }

    &__content {
      > * {
        animation: heroContentIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) backwards;

        &:nth-child(1) {
          animation-delay: 0.2s;
        }
        &:nth-child(2) {
          animation-delay: 0.45s;
        }
        &:nth-child(3) {
          animation-delay: 0.7s;
        }
        &:nth-child(4) {
          animation-delay: 0.95s;
        }
      }

      h1 {
        font-weight: 300;
        letter-spacing: -0.02em;
        @include fluid(28px, 52px, $property: margin-bottom);
        @include fluid(36px, 64px);

        strong {
          font-weight: 600;
        }
      }

      p {
        font-size: 1.5rem;
        @include fluid(20px, 24px);
        margin: 0;
        text-wrap: balance;
        line-height: 1.2;

        &.subtitle {
          text-transform: uppercase;
          margin: 0;
          @include fluid(16px, 20px);
          font-weight: 700;
          @include fluid(16px, 24px, $property: margin-bottom);
        }
      }
    }
  }

  .collaboration-badge {
    max-width: 410px;
    align-items: center;
    backdrop-filter: blur(6px);
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.03);
    display: flex;
    gap: 20px;
    justify-content: space-between;
    padding: 12px;
    margin-top: 2.5rem;

    @media (min-width: 768px) {
      padding: 8px 24px;
    }

    .collaborators {
      display: flex;
      gap: 20px;

      .collaborator {
        display: flex;
        margin: 0;

        img {
          height: 18px;

          @media (min-width: 768px) {
            height: 20px;
          }
        }
      }
    }

    span {
      color: #f2f4f9;
      font-size: 12px;
      font-weight: 300;
      padding: 4px 0;

      @media (min-width: 768px) {
        font-size: 16px;
      }
    }
  }

  @keyframes heroContentIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hotspot {
    width: 8px;
    height: 8px;
    background: var(--esk-primary-color);
    border-radius: 32px;
    border: 0;
    box-sizing: border-box;
    cursor: pointer;
    padding: 4px;
    position: relative;
    opacity: 0;
    pointer-events: none;
    transform: translate(0%, -50%) scale(0);
    transition:
      opacity 0.3s,
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);

    &:before,
    &:after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background-color: var(--esk-primary-color);
      opacity: 0.5;
      animation: pulse 2s infinite;
    }

    &:after {
      animation-delay: 1s;
    }

    @keyframes pulse {
      0% {
        transform: scale(1);
        opacity: 0.5;
      }
      100% {
        transform: scale(2.5);
        opacity: 0;
      }
    }

    &:focus {
      border: 4px solid var(--esk-primary-color);
      outline: none;
    }
  }

  .hotspot-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }

  .hotspot-line {
    stroke: var(--esk-primary-color);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .hotspot-label {
    pointer-events: none;
    background-color: var(--esk-primary-color--light);
    border-radius: 4px;
    border: 1px solid var(--esk-primary-color);
    color: #000;
    cursor: pointer;
    display: block;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 8px;
    width: max-content;
    max-width: 160px;
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: opacity 0.3s;
    backdrop-filter: blur(6px);

    @include bp(tablet) {
      padding: 9px 12px;
    }

    &:not([data-visible]) {
      opacity: 0;
      pointer-events: none;
    }
  }

  .block-hero__asset-container.is-loaded {
    .hotspot[data-visible] {
      opacity: 1;
      pointer-events: auto;
      transform: translate(0%, -50%) scale(1);
    }

    .hotspot-line {
      opacity: 1;
    }

    .hotspot-line.is-occluded {
      opacity: 0;
    }

    .hotspot-label[data-visible] {
      opacity: 1;
      pointer-events: auto;
    }
  }

  .block-hero__asset-container.is-zoomed {
    .hotspot-label:not(.is-active),
    .hotspot-line:not(.is-active) {
      opacity: 0;
      pointer-events: none;
    }
  }
</style>
