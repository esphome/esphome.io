        alt="ESPHome Starter Kit 3D model"
        ar
        ar-modes="webxr scene-viewer quick-look"
        camera-controls
        disable-zoom
        disable-pan
        disable-tap
        touch-action="pan-y"
        min-camera-orbit="auto auto 0m"
        tone-mapping="neutral"
        poster="/starter-kit/poster.webp"
        shadow-intensity="1"
        tone-mapping="aces"
      >
        <button
          class="hotspot"
          slot="hotspot-1"
          data-position="-0.5605654272973684m 2.3497694925085417m 0.1577726669933136m"
          data-normal="0m -4.7181972549813103e-7m 0.9999999999998889m"
          data-visibility-attribute="visible"
          aria-label="Button module"></button>
        <button
          class="hotspot"
          slot="hotspot-2"
          data-position="0.06594962962506401m 2.505031394564349m 0.04108281874086464m"
          data-normal="0m -3.021140994925911e-7m 0.9999999999999545m"
          data-visibility-attribute="visible"
          aria-label="Temp & hum module"></button>
        <button
          class="hotspot"
          slot="hotspot-3"
          data-position="0.6767021090234897m 2.551928830256844m 0.10511088381804498m"
          data-normal="-7.549788288176731e-8m 1.352368577797927e-7m 0.999999999999988m"
          data-visibility-attribute="visible"
          aria-label="Motion module"></button>
        <button
          class="hotspot"
          slot="hotspot-4"
          data-position="0.03080501274970332m 1.3308043464158432m 0.0410827821529187m"
          data-normal="0m -6.28895230895957e-8m 0.999999999999998m"
          data-visibility-attribute="visible"
          aria-label="LED & buzzer module"></button>
        <button
          class="hotspot"
          slot="hotspot-5"
          data-position="-0.2379975457681977m 0.06684272313252704m 0.10484313944579174m"
          data-normal="0m -6.74608119632293e-8m 0.9999999999999979m"
          data-visibility-attribute="visible"
          aria-label="ESP32 Microcontroller"></button>

        <svg
          class="hotspot-lines"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <line class="hotspot-line" data-hotspot="hotspot-1"></line>
          <line class="hotspot-line" data-hotspot="hotspot-2"></line>
          <line class="hotspot-line" data-hotspot="hotspot-3"></line>
          <line class="hotspot-line" data-hotspot="hotspot-4"></line>
          <line class="hotspot-line" data-hotspot="hotspot-5"></line>
        </svg>

        <div class="hotspot-labels">
          <button
            class="hotspot-label hotspot-label--button"
            data-hotspot="hotspot-1"
            data-zoom="1.8m"
          >
            Button module
          </button>
          <button
            class="hotspot-label hotspot-label--temp"
            data-hotspot="hotspot-2"
            data-zoom="1.5m"
          >
            Temp & hum module
          </button>
          <button
            class="hotspot-label hotspot-label--motion"
            data-hotspot="hotspot-3"
            data-zoom="1.5m"
          >
            Motion module
