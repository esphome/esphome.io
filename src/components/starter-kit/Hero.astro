<section class="block-hero">
  <div class="container">
    <div class="block-hero__content-container">
      <div class="block-hero__content">
        <h1><strong>ESPHome</strong> Starter Kit</h1>
        <p class="subtitle">BUILD. LEARN. AUTOMATE.</p>
        <p>The easiest path to building your own smart home devices</p>

        <div class="collaboration-badge">
          <span>Designed and built by</span>
          <div class="collaborators">
            <div class="collaborator">
              <img
                src="/images/collaboration/apollo-automation.svg"
                alt="Apollo Automation Logo"
                class="light:sl-hidden"
              />
              <img
                src="/images/collaboration/apollo-automation--light.svg"
                alt="Apollo Automation Logo"
                aria-hidden="true"
                class="dark:sl-hidden"
              />
            </div>
            <div class="collaborator">
              <img
                src="/images/collaboration/open-home-foundation.svg"
                alt="Open Home Foundation Logo"
                class="light:sl-hidden"
              />
              <img
                src="/images/collaboration/open-home-foundation--light.svg"
                alt="Open Home Foundation Logo"
                aria-hidden="true"
                class="dark:sl-hidden"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="block-hero__asset-container">
      <div class="block-hero__asset-stage" data-hero-loading>
        <canvas id="hero-scene"></canvas>
        <div class="hero-progress" id="hero-progress" aria-hidden="true">
          <div class="hero-progress__fill"></div>
        </div>
        <svg class="block-hero__label-lines" aria-hidden="true"></svg>
        <div class="block-hero__loader" aria-hidden="true"></div>
        <slot name="labels" />
        <slot />
        <aside
          class="hero-detail-card"
          id="hero-detail-card"
          aria-hidden="true"
        >
          <h3 class="hero-detail-card__title" data-detail-title></h3>
          <div class="hero-detail-card__body" data-detail-body></div>
        </aside>
      </div>
    </div>
  </div>
</section>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
  import { MeshoptDecoder } from "three/addons/libs/meshopt_decoder.module.js";
  const MODEL_URL = "/starter-kit/ESK.glb";

  const canvas = document.getElementById(
    "hero-scene",
  ) as HTMLCanvasElement | null;

  if (canvas) {
    const getSize = () => ({
      width: canvas.clientWidth || 1,
      height: canvas.clientHeight || 1,
    });

    let { width, height } = getSize();
    let homeDistance = 10;
    const HOME_ZOOM_MOBILE = 0.98;
    const HOME_ZOOM_TABLET = 1.85;
    const HOME_ZOOM_DESKTOP = 1.15;

    const homeZoom = () =>
      window.innerWidth <= 767
        ? HOME_ZOOM_MOBILE
        : window.innerWidth <= 1024
          ? HOME_ZOOM_TABLET
          : HOME_ZOOM_DESKTOP;
    let modelScaledSize: THREE.Vector3 | null = null;

    const scene = new THREE.Scene();

    // Isometric-style direction: 45° azimuth, ~23° elevation (Y=0.5 flattens
    // from the classic 35° to keep the model readable without a bird's-eye feel).
    const CAM_DIR = new THREE.Vector3(1, 0, 1).normalize();

    const camera = new THREE.PerspectiveCamera(35, width / height, 0.01, 100);

    camera.position.copy(CAM_DIR).multiplyScalar(10);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      depth: true,
      powerPreference: "high-performance",
    });
    // Use the device's full pixel ratio so thin wireframe lines and edge
    // outlines stay crisp on hi-DPI displays.
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.setSize(width, height, false);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.1;
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    scene.add(new THREE.AmbientLight(0xffffff, 0.6));

    const keyLight = new THREE.DirectionalLight(0xffffff, 2.0);
    keyLight.position.set(3, 4, 2);
    scene.add(keyLight);

    const fillLight = new THREE.DirectionalLight(0xa9c8ff, 0.8);
    fillLight.position.set(-3, 1, -2);
    scene.add(fillLight);

    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.enableZoom = false;
    controls.enablePan = false;
    controls.enableRotate = true;
    controls.autoRotate = false;
    // OrbitControls sets touch-action: none inline. Override on touch devices
    // so vertical swipes scroll the page rather than rotating the model.
    if (window.matchMedia("(pointer: coarse)").matches) {
      canvas.style.touchAction = "pan-y";
    }

    const loader = new GLTFLoader();
    loader.setMeshoptDecoder(MeshoptDecoder);

    const assetContainer = canvas.parentElement as HTMLElement | null;
    const labelOverlay =
      assetContainer?.querySelector<SVGSVGElement>(
        ".block-hero__label-lines",
      ) ?? null;
    const labelEls = assetContainer
      ? Array.from(
          assetContainer.querySelectorAll<HTMLElement>("[data-hero-label]"),
        )
      : [];

    type LabelRef = {
      el: HTMLElement;
      target: THREE.Object3D | null;
      line: SVGLineElement | null;
      dot: SVGCircleElement | null;
      anchor: THREE.Vector3;
      offsetX: number;
      offsetY: number;
      currentX: number;
      currentY: number;
      hasPosition: boolean;
      groupIdx: number;
      detailHTML: string;
      labelText: string;
    };

    const SVG_NS = "http://www.w3.org/2000/svg";
    let cycleUpdater: (now: number) => void = () => {};
    let labelsEnabled = false;
    const labels: LabelRef[] = labelEls.map((el) => {
      let line: SVGLineElement | null = null;
      let dot: SVGCircleElement | null = null;
      if (labelOverlay) {
        line = document.createElementNS(SVG_NS, "line");
        line.setAttribute("class", "block-hero__label-line");
        line.setAttribute("stroke", "rgba(255, 255, 255, 0.7)");
        line.setAttribute("stroke-width", "1");
        line.setAttribute("stroke-dasharray", "3 3");
        line.setAttribute("visibility", "hidden");
        labelOverlay.appendChild(line);

        dot = document.createElementNS(SVG_NS, "circle");
        dot.setAttribute("class", "block-hero__label-dot");
        dot.setAttribute("r", "4");
        dot.setAttribute("fill", "#fff");
        dot.setAttribute("stroke", "rgba(255, 255, 255, 0.25)");
        dot.setAttribute("stroke-width", "4");
        dot.setAttribute("visibility", "hidden");
        labelOverlay.appendChild(dot);
      }
      return {
        el,
        target: null,
        line,
        dot,
        anchor: new THREE.Vector3(),
        offsetX: Number(el.dataset.offsetX ?? 0),
        offsetY: Number(el.dataset.offsetY ?? -80),
        currentX: 0,
        currentY: 0,
        hasPosition: false,
        groupIdx: -1,
        detailHTML:
          el.querySelector<HTMLElement>("[data-label-detail]")?.innerHTML ?? "",
        labelText: el.dataset.labelText ?? "",
      };
    });

    loader.load(
      MODEL_URL,
      (gltf: { scene: THREE.Group }) => {
        assetContainer?.removeAttribute("data-hero-loading");

        const model = gltf.scene;

        // Measure model in its local space, then scale uniformly.
        const localBox = new THREE.Box3().setFromObject(model);
        const localSize = new THREE.Vector3();
        localBox.getSize(localSize);

        const maxDim = Math.max(localSize.x, localSize.y, localSize.z) || 1;
        const targetSize = 1.6;
        const scale = targetSize / maxDim;
        model.scale.setScalar(scale);

        // Recompute the bbox AFTER scaling, then offset so the model is
        // centered on the origin in world space.
        const scaledBox = new THREE.Box3().setFromObject(model);
        const scaledCenter = new THREE.Vector3();
        scaledBox.getCenter(scaledCenter);
        model.position.sub(scaledCenter);

        const LED_PIVOT = new THREE.Vector3(0, 0.05, 0.05);
        const ROT_AXIS = new THREE.Vector3(0, 1, 0);
        const ROT_ANGLE = Math.PI / 8;
        model.position
          .sub(LED_PIVOT)
          .applyAxisAngle(ROT_AXIS, ROT_ANGLE)
          .add(LED_PIVOT);
        model.rotateOnWorldAxis(ROT_AXIS, ROT_ANGLE);

        scene.add(model);

        // Re-measure post-rotation so camera framing uses the rotated extents.
        model.updateMatrixWorld(true);
        const finalBox = new THREE.Box3().setFromObject(model);
        const scaledSize = new THREE.Vector3();
        finalBox.getSize(scaledSize);

        // Fit to vertical FOV only — distY is stable across aspect ratios,
        // avoiding the far-back push that distX causes on narrow viewports.
        modelScaledSize = scaledSize;
        const fovY = (camera.fov * Math.PI) / 180;
        const distY = scaledSize.y / 2 / Math.tan(fovY / 2);
        homeDistance = (distY + scaledSize.z / 2) * homeZoom();
        camera.position.copy(CAM_DIR).multiplyScalar(homeDistance);
        camera.lookAt(0, 0, 0);
        controls.target.set(0, 0, 0);
        controls.update();

        // Resolve each label's target object by name (case-insensitive fallback).
        const byName = new Map<string, THREE.Object3D>();
        model.traverse((obj: THREE.Object3D) => {
          if (obj.name) byName.set(obj.name.toLowerCase(), obj);
        });

        const topLevel = [...model.children];
        model.updateMatrixWorld(true);
        const bboxLog = new THREE.Box3();
        const bboxCtr = new THREE.Vector3();
        console.group("[Hero] named objects + bbox centres");
        byName.forEach((obj, name) => {
          bboxLog.setFromObject(obj);
          bboxLog.getCenter(bboxCtr);
          console.log(
            `  "${name}"`,
            `  centre: (${bboxCtr.x.toFixed(3)}, ${bboxCtr.y.toFixed(3)}, ${bboxCtr.z.toFixed(3)})`,
          );
        });
        console.groupEnd();

        // Click any module to make it the active (solid) group; the rest
        // stay as the blueprint wireframe. Each frame, opacities and the
        // camera lerp toward the active group's state.
        const SOLID_LERP = 0.08;
        const ZOOM_LERP = 0.06;
        // Wireframe opacity when a group is fully inactive (shown while
        // another module is focused). Kept high enough that the unfocused
        // modules read as the connected blueprint they actually are.
        const WIRE_DIM = 0.3;
        // Minimum edge opacity for the active/default state. A faint sketch
        // outline is kept on every module at rest so the kit reads as one
        // designed board rather than disconnected, floating parts.
        const WIRE_MIN = 0.05;
        // Monochrome wireframe palette. Adapts to the Starlight theme so the
        // sketch stays readable on either bg:
        //   dark theme  → near-black fill, white edges
        //   light theme → near-white fill, black edges
        const EDGE_DARK = new THREE.Color(0xffffff);
        const EDGE_LIGHT = new THREE.Color(0x000000);
        const TINT_DARK = new THREE.Color(0x1f2127);
        const TINT_LIGHT = new THREE.Color(0xf3f4f7);
        const isLightTheme = () =>
          document.documentElement.dataset.theme === "light";
        const BLUEPRINT_COLOR = (
          isLightTheme() ? EDGE_LIGHT : EDGE_DARK
        ).clone();
        const TINT_COLOR = (isLightTheme() ? TINT_LIGHT : TINT_DARK).clone();
        type GroupFade = {
          root: THREE.Object3D;
          solid: THREE.Material[];
          wire: THREE.Material[];
          meshes: THREE.Mesh[];
        };

        const allEdgeOverlays: THREE.LineSegments[] = [];

        const logicalOpacity = new WeakMap<THREE.Material, number>();

        const groupFades: GroupFade[] = topLevel.map((obj, idx) => {
          const solid: THREE.Material[] = [];
          const wire: THREE.Material[] = [];
          const meshes: THREE.Mesh[] = [];
          const overlays: { parent: THREE.Mesh; mesh: THREE.LineSegments }[] =
            [];
          const masks: { parent: THREE.Mesh; mesh: THREE.Mesh }[] = [];
          // Group 0 starts solid; the rest start as wireframe.
          const initialSolid = idx === 0 ? 1 : 0;
          obj.traverse((o: THREE.Object3D) => {
            const mesh = o as THREE.Mesh;
            if (!mesh.isMesh) return;
            const src = Array.isArray(mesh.material)
              ? mesh.material[0]
              : mesh.material;
            if (!src) return;
            const solidMat = src.clone();
            solidMat.transparent = true;
            solidMat.opacity = initialSolid;
            solidMat.depthWrite = true;
            // Depth-only mask: fills the z-buffer so back-face wire edges of
            // other groups get depth-rejected. polygonOffset keeps edge lines
            // from z-fighting with the surface they lie on.
            const maskMat = new THREE.MeshBasicMaterial({
              colorWrite: false,
              depthWrite: true,
              polygonOffset: true,
              polygonOffsetFactor: 1,
              polygonOffsetUnits: 1,
            });
            const mask = new THREE.Mesh(mesh.geometry, maskMat);
            mask.renderOrder = -1;
            const lineMat = new THREE.LineBasicMaterial({
              color: BLUEPRINT_COLOR.clone(),
              transparent: true,
              opacity: initialSolid === 1 ? 0 : WIRE_DIM,
              depthWrite: false,
              depthTest: true,
            });
            const overlay = new THREE.LineSegments(
              new THREE.EdgesGeometry(mesh.geometry, 30),
              lineMat,
            );
            mesh.material = solidMat;
            masks.push({ parent: mesh, mesh: mask });
            overlays.push({ parent: mesh, mesh: overlay });
            allEdgeOverlays.push(overlay);
            solid.push(solidMat);
            wire.push(lineMat);
            meshes.push(mesh);
          });
          for (const { parent, mesh } of masks) parent.add(mesh);
          for (const { parent, mesh } of overlays) parent.add(mesh);
          return { root: obj, solid, wire, meshes };
        });

        // ---- Intro animation -------------------------------------------------
        // The "LED & buzzer" group (named "leds") fades in instantly. The
        // remaining modules follow with small random delays, each fading
        // in while translating into place from an offset along the camera
        // axis (so they appear to slide forward toward their final spot).
        const ledsIdx = Math.max(
          0,
          topLevel.findIndex((g) => g.name === "leds"),
        );
        const INTRO_LEAD_DURATION_MS = 180;
        const INTRO_FOLLOW_DURATION_MS = 650;
        const INTRO_FOLLOW_GAP_MS = 120;
        // Distance (in model-local units) each follower starts offset from
        // its final position along the camera-direction axis.
        const INTRO_OFFSET_DISTANCE = 1.6;
        const introStart = performance.now();
        const introDelays: number[] = topLevel.map((_, i) =>
          i === ledsIdx ? 0 : INTRO_FOLLOW_GAP_MS + Math.random() * 480,
        );
        const introDurations: number[] = topLevel.map((_, i) =>
          i === ledsIdx ? INTRO_LEAD_DURATION_MS : INTRO_FOLLOW_DURATION_MS,
        );
        // Followers start displaced along +Z (model-local) and slide back
        // along -Z to their final position. Tweak the sign if it ends up
        // pointing into the wrong half-space for this model's axes.
        const _offsetAxis = new THREE.Vector3(0, 0, -1).multiplyScalar(
          INTRO_OFFSET_DISTANCE,
        );
        const introOriginalPos: THREE.Vector3[] = topLevel.map((g) =>
          g.position.clone(),
        );
        const introOffset: THREE.Vector3[] = topLevel.map((_, i) =>
          i === ledsIdx ? new THREE.Vector3() : _offsetAxis.clone(),
        );
        // Hide every material on frame 0 so the model doesn't flash before
        // its intro begins. cycleUpdater fades them in via logicalOpacity.
        for (const g of groupFades) {
          for (const m of g.solid) {
            logicalOpacity.set(m, m.opacity);
            m.opacity = 0;
          }
          for (const m of g.wire) {
            logicalOpacity.set(m, m.opacity);
            m.opacity = 0;
          }
        }
        const introFactor = (i: number, now: number) => {
          const t = (now - introStart - introDelays[i]) / introDurations[i];
          if (t <= 0) return 0;
          if (t >= 1) return 1;
          // ease-out cubic
          return 1 - Math.pow(1 - t, 3);
        };

        // ---- Stage-2 camera intro -------------------------------------------
        // After the per-module items have entered, the camera rotates from
        // a near head-on view to the steady-state isometric direction. The
        // CSS in this component runs a synchronised slide on the outer
        // .block-hero__asset-container so the model also translates from
        // page-centre back to its right-hand column home.
        const homeTarget = controls.target.clone();
        const INTRO_CAM_DELAY_MS = 900;
        const INTRO_CAM_DURATION_MS = 900;
        // Match the model's yaw so the intro starts face-on to the model's
        // actual front regardless of ROT_ANGLE.
        const FRONT_CAM_DIR = new THREE.Vector3(
          Math.sin(ROT_ANGLE),
          0.35,
          Math.cos(ROT_ANGLE),
        ).normalize();
        const HOME_CAM_DIR = CAM_DIR.clone();
        // Head-on view shows the model's full X×Y face while the iso view
        // foreshortens both axes — multiply the home distance so the
        // frontal pose doesn't blow up out of frame.
        const FRONT_CAM_DIST_MUL = 1.5;
        const _introCamDir = new THREE.Vector3();
        const easeInOutCubic = (t: number) =>
          t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        // Place the camera in its starting (head-on) pose immediately so
        // the first rendered frame doesn't flash the isometric view.
        _introCamDir.copy(FRONT_CAM_DIR);
        camera.position
          .copy(controls.target)
          .addScaledVector(_introCamDir, homeDistance * FRONT_CAM_DIST_MUL);
        camera.lookAt(controls.target);
        // Lock OrbitControls until the intro completes so user drags can't
        // fight the choreographed rotation.
        controls.enabled = false;
        window.setTimeout(
          () => {
            controls.enabled = true;
            // Camera has reached its resting position — snap labels so they
            // don't lerp from their intro-animation snap position to here.
            for (const label of labels) label.hasPosition = false;
          },
          INTRO_CAM_DELAY_MS + INTRO_CAM_DURATION_MS + 100,
        );

        // Re-apply edge colour whenever Starlight flips the theme.
        const applyThemePalette = () => {
          const edge = isLightTheme() ? EDGE_LIGHT : EDGE_DARK;
          BLUEPRINT_COLOR.copy(edge);
          TINT_COLOR.copy(isLightTheme() ? TINT_LIGHT : TINT_DARK);
          for (const overlay of allEdgeOverlays) {
            (overlay.material as THREE.LineBasicMaterial).color.copy(edge);
          }
        };
        const themeObserver = new MutationObserver(applyThemePalette);
        themeObserver.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["data-theme"],
        });

        // Precompute per-group bounding spheres for the zoom animation.
        const groupFocus = topLevel.map((obj: THREE.Object3D) => {
          const box = new THREE.Box3().setFromObject(obj);
          const center = new THREE.Vector3();
          const sphere = new THREE.Sphere();
          box.getCenter(center);
          box.getBoundingSphere(sphere);
          const radius = Math.max(sphere.radius, 0.05);
          // Distance so the sphere fits the vertical FOV with margin.
          const distance = (radius / Math.sin(fovY / 2)) * 1.6;
          return { center, distance };
        });

        const desiredTarget = new THREE.Vector3();
        const desiredCamPos = new THREE.Vector3();
        const dirFromTarget = new THREE.Vector3();
        // Scratch vector for the mobile-adjusted orbit target (avoids allocating
        // a new Vector3 every frame).
        const _mobileFocusTarget = new THREE.Vector3();
        // Scratch + smoothed state for the detail card's per-frame screen
        // positioning (see cycleUpdater).
        const _detailProj = new THREE.Vector3();
        let _detailCardCurrentLeft = 0;
        let _detailCardCurrentTop = 0;
        let _detailCardHasPos = false;
        // On mobile the popup covers the bottom of the canvas, so shift the
        // orbit target down (world Y) so the module frames toward the upper
        // portion of the canvas. Also zoom in tighter.
        const MOBILE_FOCUS_Y_OFFSET = -0.05;
        const MOBILE_ZOOM_SCALE = 0.95;

        let activeIdx = -1; // -1 = all groups active (default state)
        let _returningHome = false;
        let _zoomingIn = false;

        // Card host that appears when a component is focused; populated
        // from the matching label's [data-label-detail] slot content.
        const detailCard =
          assetContainer?.querySelector<HTMLElement>("#hero-detail-card") ??
          null;
        const detailBodyEl =
          detailCard?.querySelector<HTMLElement>("[data-detail-body]") ?? null;
        const detailTitleEl =
          detailCard?.querySelector<HTMLElement>("[data-detail-title]") ?? null;

        const applyActiveState = (idx: number) => {
          const focusing = idx !== -1;
          if (focusing) {
            _zoomingIn = true;
            _returningHome = false;
          }
          for (const label of labels) {
            if (focusing) {
              // Hide all labels when a module is focused — the detail card
              // shows the title and content instead.
              label.el.classList.add("is-other-active");
            }
            // When reverting, leave is-other-active in place — cycleUpdater
            // removes it once the camera has returned to home position so
            // labels don't fade in while still at the wrong zoom/position.
          }
          if (!detailCard) return;
          if (!focusing) {
            _returningHome = true;
            detailCard.classList.remove("is-active");
            detailCard.setAttribute("aria-hidden", "true");
            if (progressBar && progressFill) {
              progressFill.style.transition = "none";
              progressFill.style.width = "0%";
              progressBar.style.opacity = "0";
            }
            return;
          }
          const match = labels.find((l) => l.groupIdx === idx);
          if (!match || !match.detailHTML) {
            detailCard.classList.remove("is-active");
            detailCard.setAttribute("aria-hidden", "true");
            return;
          }
          if (detailTitleEl) detailTitleEl.textContent = match.labelText;
          if (detailBodyEl) detailBodyEl.innerHTML = match.detailHTML;
          detailCard.classList.add("is-active");
          detailCard.setAttribute("aria-hidden", "false");
        };

        const setActive = (idx: number) => {
          if (idx === activeIdx) return;
          activeIdx = idx;
          applyActiveState(idx);
        };

        const IDLE_REVERT_MS = 5000;
        let revertTimer: ReturnType<typeof setTimeout> | undefined;
        const progressBar =
          assetContainer?.querySelector<HTMLElement>("#hero-progress") ?? null;
        const progressFill =
          progressBar?.querySelector<HTMLElement>(".hero-progress__fill") ??
          null;
        const scheduleRevert = () => {
          if (revertTimer) clearTimeout(revertTimer);
          revertTimer = setTimeout(() => {
            setActive(-1);
          }, IDLE_REVERT_MS);
          if (progressBar && progressFill) {
            progressFill.style.transition = "none";
            progressFill.style.width = "0%";
            progressBar.style.opacity = "1";
            requestAnimationFrame(() => {
              progressFill.style.transition = `width ${IDLE_REVERT_MS}ms linear`;
              progressFill.style.width = "100%";
            });
          }
        };
        const cancelRevert = () => {
          if (revertTimer) {
            clearTimeout(revertTimer);
            revertTimer = undefined;
          }
          if (progressBar && progressFill) {
            progressFill.style.transition = "none";
            progressFill.style.width = "0%";
            progressBar.style.opacity = "0";
          }
        };

        // Shared handler for both mesh clicks and label clicks.
        // Clicking the active module reverts; clicking any other focuses it
        // and starts the idle-revert countdown.
        const focusModule = (idx: number) => {
          if (idx === activeIdx) {
            setActive(-1);
            cancelRevert();
          } else {
            setActive(idx);
            cancelRevert();
            scheduleRevert();
          }
        };

        const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

        cycleUpdater = (now: number) => {
          if (!groupFades.length) return;

          // Lerp every group's solid/wire opacity toward its target state.
          for (let i = 0; i < groupFades.length; i++) {
            const { solid, wire, root } = groupFades[i];
            // activeIdx === -1 means "all active" — every group reads solid;
            // otherwise the selected group is solid, the rest go wireframe.
            const isActive = activeIdx === -1 || i === activeIdx;
            const targetSolid = isActive ? 1 : 0;
            // Keep a faint pencil-sketch edge on every module even in the
            // fully-solid state so the assembly reads as one designed board.
            const targetWire = isActive
              ? WIRE_MIN
              : WIRE_DIM * (1 - targetSolid) + WIRE_MIN * targetSolid;
            const introF = introFactor(i, now);
            root.position
              .copy(introOriginalPos[i])
              .addScaledVector(introOffset[i], 1 - introF);
            for (const m of solid) {
              const next = lerp(
                logicalOpacity.get(m) ?? m.opacity,
                targetSolid,
                SOLID_LERP,
              );
              logicalOpacity.set(m, next);
              m.opacity = next * introF;
            }
            for (const m of wire) {
              const next = lerp(
                logicalOpacity.get(m) ?? m.opacity,
                targetWire,
                SOLID_LERP,
              );
              logicalOpacity.set(m, next);
              m.opacity = next * introF;
            }
          }

          // Stage-2 intro: override camera direction (and distance) while
          // it rotates from the head-on starting pose to the isometric
          // home direction. The standard zoom-lerp below preserves
          // whatever direction we leave here, so once the intro completes
          // this block becomes a no-op.
          const camT =
            (now - introStart - INTRO_CAM_DELAY_MS) / INTRO_CAM_DURATION_MS;
          if (camT < 1) {
            const eased = easeInOutCubic(Math.max(0, Math.min(1, camT)));
            _introCamDir
              .copy(FRONT_CAM_DIR)
              .lerp(HOME_CAM_DIR, eased)
              .normalize();
            const dist = lerp(
              homeDistance * FRONT_CAM_DIST_MUL,
              homeDistance,
              eased,
            );
            camera.position
              .copy(controls.target)
              .addScaledVector(_introCamDir, dist);
            camera.lookAt(controls.target);
          }

          // Camera zoom: lerp toward the focused group when one is selected,
          // otherwise lerp back to the home (overview) framing. Direction is
          // preserved so OrbitControls drag still works.
          const focus = activeIdx !== -1 ? groupFocus[activeIdx] : null;
          const isMobile = width < 768;
          const ZOOM_LERParget = focus
            ? isMobile
              ? _mobileFocusTarget
                  .copy(focus.center)
                  .setY(focus.center.y + MOBILE_FOCUS_Y_OFFSET)
              : focus.center
            : homeTarget;
          const zoomDistance = focus
            ? focus.distance * (isMobile ? MOBILE_ZOOM_SCALE : 1)
            : homeDistance;
          desiredTarget.copy(controls.target).lerp(ZOOM_LERParget, ZOOM_LERP);
          controls.target.copy(desiredTarget);
          dirFromTarget.copy(camera.position).sub(controls.target);
          const currentDist = dirFromTarget.length() || 0.001;
          dirFromTarget.normalize();
          // Steer direction only during active transitions — never while the
          // user is freely browsing, so drags aren't fought or snapped back.
          if (_zoomingIn) {
            dirFromTarget.lerp(FRONT_CAM_DIR, ZOOM_LERP).normalize();
            if (dirFromTarget.dot(FRONT_CAM_DIR) > 0.9998) _zoomingIn = false;
          } else if (_returningHome) {
            dirFromTarget.lerp(CAM_DIR, ZOOM_LERP).normalize();
            if (dirFromTarget.dot(CAM_DIR) > 0.9998) {
              _returningHome = false;
              for (const label of labels)
                label.el.classList.remove("is-other-active");
            }
          }
          const nextDist = lerp(currentDist, zoomDistance, ZOOM_LERP);
          desiredCamPos
            .copy(controls.target)
            .addScaledVector(dirFromTarget, nextDist);
          camera.position.copy(desiredCamPos);

          // Detail card placement: when a module is focused, anchor the card
          // just below the projected centre of that module so it reads as a
          // callout for the zoomed-in part rather than a corner overlay.
          // Mobile (width < 768) keeps the bottom-sheet behaviour from CSS.
          if (detailCard) {
            if (width < 768 || activeIdx === -1) {
              if (_detailCardHasPos) {
                detailCard.style.left = "";
                detailCard.style.top = "";
                detailCard.style.bottom = "";
                _detailCardHasPos = false;
              }
            } else {
              const focusGroup = groupFocus[activeIdx];
              if (focusGroup) {
                _detailProj.copy(focusGroup.center).project(camera);
                const screenX = ((_detailProj.x + 1) / 2) * width;
                const screenY = ((-_detailProj.y + 1) / 2) * height;
                const cardW = detailCard.offsetWidth || 280;
                const cardH = detailCard.offsetHeight || 100;
                const MARGIN = 16;
                // Drop the card below the projected module centre by a
                // distance that scales with viewport height, so on tall
                // viewports the card doesn't crowd the module.
                const drop = Math.min(140, Math.max(70, height * 0.18));
                const desiredLeft = Math.max(
                  MARGIN,
                  Math.min(width - cardW - MARGIN, screenX - cardW / 2),
                );
                const desiredTop = Math.max(
                  MARGIN,
                  Math.min(height - cardH - MARGIN, screenY + drop),
                );
                if (!_detailCardHasPos) {
                  _detailCardCurrentLeft = desiredLeft;
                  _detailCardCurrentTop = desiredTop;
                  _detailCardHasPos = true;
                } else {
                  _detailCardCurrentLeft +=
                    (desiredLeft - _detailCardCurrentLeft) * 0.18;
                  _detailCardCurrentTop +=
                    (desiredTop - _detailCardCurrentTop) * 0.18;
                }
                detailCard.style.left = `${_detailCardCurrentLeft}px`;
                detailCard.style.top = `${_detailCardCurrentTop}px`;
                detailCard.style.bottom = "auto";
              }
            }
          }
        };

        // Raycaster click handling: pick whichever top-level group contains
        // the intersected mesh and make it active.
        const raycaster = new THREE.Raycaster();
        const pointer = new THREE.Vector2();
        const allMeshes = groupFades.flatMap((g) => g.meshes);
        const groupForObject = (obj: THREE.Object3D | null): number => {
          while (obj) {
            const idx = topLevel.indexOf(obj);
            if (idx !== -1) return idx;
            obj = obj.parent;
          }
          return -1;
        };
        // Distinguish click vs drag: if the pointer travels more than a few
        // pixels between down and up we treat it as a drag (orbit) and skip
        // focusing the model.
        const heroPrompt =
          assetContainer?.querySelector<HTMLElement>(".hero-prompt") ?? null;
        canvas.addEventListener(
          "pointerdown",
          () => {
            heroPrompt?.classList.add("hero-prompt--hidden");
          },
          { once: true },
        );

        const CLICK_MOVE_THRESHOLD_SQ = 25;
        let pointerDown: { x: number; y: number; id: number } | null = null;
        canvas.addEventListener("pointerdown", (event) => {
          pointerDown = {
            x: event.clientX,
            y: event.clientY,
            id: event.pointerId,
          };
        });
        canvas.addEventListener("pointerup", (event) => {
          const start = pointerDown;
          pointerDown = null;
          if (!start || start.id !== event.pointerId) return;
          const dx = event.clientX - start.x;
          const dy = event.clientY - start.y;
          // Treat as a click only if the pointer barely moved between
          // down and up; otherwise it was a drag (orbit) and we ignore it.
          if (dx * dx + dy * dy > CLICK_MOVE_THRESHOLD_SQ) return;
          const rect = canvas.getBoundingClientRect();
          pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
          pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
          raycaster.setFromCamera(pointer, camera);
          const hits = raycaster.intersectObjects(allMeshes, false);
          if (!hits.length) return;
          const idx = groupForObject(hits[0].object);
          if (idx !== -1) focusModule(idx);
        });
        canvas.addEventListener("pointercancel", () => {
          pointerDown = null;
        });
        // While the user is actively manipulating OrbitControls (drag/zoom)
        // pause the idle timer; restart it on release so the 3s countdown
        // measures inactivity rather than total elapsed time.
        controls.addEventListener("start", () => {
          _zoomingIn = false;
          cancelRevert();
        });
        controls.addEventListener("end", () => {
          if (activeIdx !== -1) scheduleRevert();
        });
        canvas.style.cursor = "pointer";

        for (const label of labels) {
          const positionAttr = label.el.dataset.position;
          if (positionAttr) {
            const [px, py, pz] = positionAttr.split(",").map(Number);
            const anchor = new THREE.Object3D();
            anchor.position.set(px || 0, py || 0, pz || 0);
            anchor.position
              .sub(LED_PIVOT)
              .applyAxisAngle(ROT_AXIS, ROT_ANGLE)
              .add(LED_PIVOT);
            scene.add(anchor);
            label.target = anchor;
            continue;
          }

          const name = label.el.dataset.target?.toLowerCase();
          if (!name) continue;
          const obj = byName.get(name) ?? null;
          if (!obj) {
            console.warn(
              `[Hero] No object named "${label.el.dataset.target}" found in model.`,
            );
            continue;
          }
          // Place the anchor at the bbox centre of the named group so the
          // dot appears at the visual midpoint rather than the group origin.
          const bboxCenter = new THREE.Vector3();
          new THREE.Box3().setFromObject(obj).getCenter(bboxCenter);
          const anchor = new THREE.Object3D();
          anchor.position.copy(bboxCenter);
          scene.add(anchor);
          label.target = anchor;
        }

        // Map each label to its nearest top-level group so we know which
        // labels to keep visible (and which detail card to show) when a
        // component is focused.
        const tmpWorld = new THREE.Vector3();
        for (const label of labels) {
          if (!label.target) continue;
          label.target.getWorldPosition(tmpWorld);
          let bestIdx = -1;
          let bestDist = Infinity;
          for (let i = 0; i < groupFocus.length; i++) {
            const d = tmpWorld.distanceToSquared(groupFocus[i].center);
            if (d < bestDist) {
              bestDist = d;
              bestIdx = i;
            }
          }
          label.groupIdx = bestIdx;
        }

        // Wire up label clicks — same behaviour as clicking the mesh directly.
        for (const label of labels) {
          label.el.addEventListener("click", () => {
            heroPrompt?.classList.add("hero-prompt--hidden");
            if (label.groupIdx !== -1) focusModule(label.groupIdx);
          });
        }

        setTimeout(() => {
          labelsEnabled = true;
        }, 600);
      },
      undefined,
      (error: unknown) => {
        console.error("[Hero] Failed to load model:", error);
        assetContainer?.removeAttribute("data-hero-loading");
      },
    );

    // Recomputes homeDistance for the current viewport and snaps the camera
    // to that distance along its current direction. No-op until model loads.
    const refitCamera = () => {
      if (!modelScaledSize) return;
      const fovRad = (camera.fov * Math.PI) / 180;
      const distY = modelScaledSize.y / 2 / Math.tan(fovRad / 2);
      homeDistance = (distY + modelScaledSize.z / 2) * homeZoom();
      const dir = camera.position.clone().sub(controls.target).normalize();
      camera.position.copy(controls.target).addScaledVector(dir, homeDistance);
    };

    const resize = () => {
      const next = getSize();
      if (next.width === width && next.height === height) return;
      width = next.width;
      height = next.height;
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      refitCamera();
      for (const label of labels) label.hasPosition = false;
    };

    new ResizeObserver(resize).observe(canvas);

    const projected = new THREE.Vector3();

    const updateLabels = () => {
      if (!assetContainer || !labels.length) return;
      const w = width;
      const h = height;
      if (labelOverlay) {
        labelOverlay.setAttribute("viewBox", `0 0 ${w} ${h}`);
      }

      // Pass 1: project anchors, compute initial label positions, hide
      // anything off-screen.
      const visible: Array<{
        label: (typeof labels)[number];
        targetX: number;
        targetY: number;
        labelX: number;
        labelY: number;
        halfW: number;
        halfH: number;
      }> = [];

      for (const label of labels) {
        if (!label.target) continue;

        label.target.getWorldPosition(label.anchor);
        projected.copy(label.anchor).project(camera);

        const onScreen =
          projected.z > -1 &&
          projected.z < 1 &&
          projected.x > -1.1 &&
          projected.x < 1.1 &&
          projected.y > -1.1 &&
          projected.y < 1.1;

        // Hide the SVG line/dot for labels that are off-screen OR
        // suppressed because another component is currently focused.
        const suppressed = label.el.classList.contains("is-other-active");
        if (!onScreen || suppressed) {
          label.el.classList.remove("is-ready");
          label.hasPosition = false;
          if (label.line) label.line.setAttribute("visibility", "hidden");
          if (label.dot) label.dot.setAttribute("visibility", "hidden");
          continue;
        }

        const targetX = ((projected.x + 1) / 2) * w;
        const targetY = ((-projected.y + 1) / 2) * h;

        if (label.dot) {
          label.dot.setAttribute("cx", String(targetX));
          label.dot.setAttribute("cy", String(targetY));
          if (labelsEnabled) label.dot.removeAttribute("visibility");
        }

        visible.push({
          label,
          targetX,
          targetY,
          labelX: targetX + label.offsetX,
          labelY: targetY + label.offsetY,
          halfW: label.el.offsetWidth / 2,
          halfH: label.el.offsetHeight / 2,
        });
      }

      // Pass 2: iteratively separate any overlapping label boxes.
      // Boxes are centred on (labelX, labelY) because of translate(-50%, -50%).
      const PADDING = 6;
      const MAX_ITER = 8;
      for (let iter = 0; iter < MAX_ITER; iter++) {
        let moved = false;
        for (let i = 0; i < visible.length; i++) {
          for (let j = i + 1; j < visible.length; j++) {
            const a = visible[i];
            const b = visible[j];
            const dx = b.labelX - a.labelX;
            const dy = b.labelY - a.labelY;
            const minDistX = a.halfW + b.halfW + PADDING;
            const minDistY = a.halfH + b.halfH + PADDING;
            const overlapX = minDistX - Math.abs(dx);
            const overlapY = minDistY - Math.abs(dy);
            if (overlapX <= 0 || overlapY <= 0) continue;

            // Separate along the axis with the smaller overlap.
            if (overlapY <= overlapX) {
              const push = overlapY / 2;
              const sign = dy === 0 ? 1 : Math.sign(dy);
              a.labelY -= sign * push;
              b.labelY += sign * push;
            } else {
              const push = overlapX / 2;
              const sign = dx === 0 ? 1 : Math.sign(dx);
              a.labelX -= sign * push;
              b.labelX += sign * push;
            }
            moved = true;
          }
        }
        if (!moved) break;
      }

      // Pass 3: smooth toward the resolved positions and commit them.
      // First appearance snaps; subsequent frames ease for a softer feel.
      const LERP = 0.18;
      for (const v of visible) {
        const desiredX = v.labelX;
        const desiredY = v.labelY;

        if (!v.label.hasPosition) {
          v.label.currentX = desiredX;
          v.label.currentY = desiredY;
          v.label.hasPosition = true;
        } else {
          v.label.currentX += (desiredX - v.label.currentX) * LERP;
          v.label.currentY += (desiredY - v.label.currentY) * LERP;
        }

        const finalX = v.label.currentX;
        const finalY = v.label.currentY;

        v.label.el.style.left = `${finalX}px`;
        v.label.el.style.top = `${finalY}px`;

        if (v.label.line) {
          // Clip the label-side endpoint to the edge of the label's box so
          // the line doesn't disappear inside the pill. Small padding keeps
          // it from visually touching the border.
          const LINE_GAP = 2;
          const dx = finalX - v.targetX;
          const dy = finalY - v.targetY;
          let edgeX = finalX;
          let edgeY = finalY;
          if (dx !== 0 || dy !== 0) {
            const halfW = v.halfW + LINE_GAP;
            const halfH = v.halfH + LINE_GAP;
            const tx = dx !== 0 ? halfW / Math.abs(dx) : Infinity;
            const ty = dy !== 0 ? halfH / Math.abs(dy) : Infinity;
            const t = Math.min(tx, ty, 1);
            edgeX = finalX - dx * t;
            edgeY = finalY - dy * t;
          }

          v.label.line.setAttribute("x1", String(edgeX));
          v.label.line.setAttribute("y1", String(edgeY));
          v.label.line.setAttribute("x2", String(v.targetX));
          v.label.line.setAttribute("y2", String(v.targetY));
          if (labelsEnabled) v.label.line.removeAttribute("visibility");
        }

        if (labelsEnabled) v.label.el.classList.add("is-ready");
      }
    };

    renderer.setAnimationLoop(() => {
      controls.update();
      cycleUpdater(performance.now());
      renderer.render(scene, camera);
      updateLabels();
    });
  }
</script>

