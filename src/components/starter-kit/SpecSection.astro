---
import TitleText from "@components/starter-kit/TitleText.astro";
import SpecItem from "@components/starter-kit/SpecItem.astro";
---

<section id="specs" class="block-specs">
  <TitleText>
    <h2 slot="title" class="title">Specifications</h2>
    <p slot="text">
      The ESPHome Starter Kit uses the same high-performance parts found in
      professional smart home devices, ensuring what you build today stays in
      your home for years to come.
    </p>
  </TitleText>

  <div class="container">
    <div class="specs fade-up">
      <div class="specs-col col">
        <div class="spec-title-container">
          <h3 class="spec-title">Product details</h3>
        </div>

        <div class="spec-items">
          <SpecItem title="Main board">
            <li>Espressif ESP32-C6-MINI-1</li>
            <li>Operating temperature: -40 °C to +85 °C</li>
          </SpecItem>
          <SpecItem title="Power and data">
            <li>USB-C, 5 V DC</li>
            <li>Optional power: rechargeable LiPo battery (sold separately)</li>
          </SpecItem>
          <SpecItem title="Connectivity">
            <li>Wi-Fi, Bluetooth LE, Thread</li>
            <li>Zigbee possible at the chip level for advanced users</li>
          </SpecItem>
          <SpecItem title="Module ports">
            <li>2 × 14-pin FPC</li>
          </SpecItem>
          <SpecItem title="Onboard indicators">
            <li>RGB status LED</li>
          </SpecItem>
          <SpecItem title="Configuration software">
            <li>ESPHome Desktop (free download for Mac, Windows, Linux)</li>
            <li>ESPHome add-on for Home Assistant</li>
          </SpecItem>
        </div>

        <div class="spec-title-container">
          <h3 class="spec-title">Module specifications</h3>
          <p>
            Each module connects to the main board with a 14-pin FPC ribbon
            cable. Two modules can run on the main board at the same time.
          </p>
        </div>

        <div class="spec-items">
          <SpecItem title="PIR motion sensor">
            <li>MH-SR602, up to 3.5 m detection range</li>
            <li>Operating temperature: -20 °C to +80 °C</li>
          </SpecItem>
          <SpecItem title="Temperature & humidity">
            <li>AHT20F (±0.3 °C, ±2% RH)</li>
            <li>Operating temperature: -40 °C to +85 °C</li>
          </SpecItem>
          <SpecItem title="Button">
            <li>Tactile pushbutton</li>
            <li>Operating temperature: -25 °C to +85 °C (typical)</li>
          </SpecItem>
          <SpecItem title="Notification module">
            <li>
              ESPHome “Casita” board: 10 × programmable RGB LEDs and piezo
              buzzer
            </li>
            <li>
              Operating temperature: -20 °C to +70 °C (typical for LEDs and
              piezo)
            </li>
          </SpecItem>
          <SpecItem title="Stand">
            <li>Included</li>
          </SpecItem>
          <SpecItem title="Ribbon cables">
            <li>3 × FPC (flexible printed circuit)</li>
            <li>Operating temperature: -40 °C to +85 °C (typical)</li>
          </SpecItem>
        </div>

        <div class="spec-title-container">
          <h3 class="spec-title">Environmental conditions for operation</h3>
        </div>
        <div class="spec-items">
          <SpecItem title="Operating environment">
            <li>Indoor use only</li>
            <li>-20 °C to +70 °C</li>
            <li>-4 °F to +158 °F</li>
            <li>Humidity: non-condensing</li>
            <li>
              (Overall range bound by the narrowest component: the Casita
              module’s RGB LEDs and piezo buzzer)
            </li>
          </SpecItem>
          <SpecItem title="Storage and care">
            <li>
              Keep in a dry, not excessively dusty environment to avoid damage
              to the unit.
            </li>
            <li>
              Do not leave the unit in direct sunlight or near any heat source,
              as this can cause overheating.
            </li>
          </SpecItem>
        </div>

        <div class="spec-title-container">
          <h3 class="spec-title">Device characteristics</h3>
        </div>
        <div class="spec-items">
          <SpecItem title="Dimensions">
            <li>Main board: 35 × 18 × 10 mm</li>
            <li>Module board: 82 × 74 × 10 mm</li>
          </SpecItem>
          <SpecItem title="In the box">
            <li>ESPHome ESP32-C6 main board</li>
            <li>
              ESPHome Starter Kit module board (temperature and humidity sensor,
              button, and ESPHome “Casita” notification modules)
            </li>
            <li>PIR motion sensor</li>
            <li>Stand</li>
            <li>3 × FPC ribbon cables</li>
          </SpecItem>
          <SpecItem title="Material">
            <li>PCB-based open design</li>
          </SpecItem>
        </div>
      </div>
    </div>
    <div class="asset-col col">
      <canvas id="spec-scene"></canvas>
    </div>
  </div>

  <style lang="scss">
    @use "../../styles/mixins" as *;

    .container {
      // flex-direction: column;

      // @include bp(tablet) {
      //   flex-direction: row;
      // }
    }

    .specs {
      width: 100%;
      display: flex;
      flex-direction: row;
      gap: 5rem;
    }

    .specs-col {
      width: 100%;
      flex-grow: 1;
    }

    .asset-col {
      width: 50%;
      height: 70vw;
      max-height: 480px;
      position: sticky;
      top: calc(var(--sl-nav-height) + 80px);

      @include bp(tablet) {
        height: calc(100vh - var(--sl-nav-height) - 80px);
        max-height: unset;
      }

      canvas {
        width: 100%;
        height: 100%;
        display: block;
      }
    }

    .col {
      //
    }

    .spec-title-container {
      margin-top: 2.5rem;
      margin-bottom: 1rem;

      &:first-child {
        margin-top: 0;
      }

      .spec-title {
        @include fluid(20, 24);
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 1.25rem;
      }

      p {
        line-height: 1.3;
        text-wrap: balance;
      }
    }

    .spec-items {
      display: flex;
      flex-direction: column;
      flex-wrap: wrap;
      gap: 1.5rem;

      @include bp(tablet) {
        flex-direction: row;
        gap: 1.25rem 2.5rem;
      }
    }
  </style>
  <script>
    import * as THREE from "three";
    import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
    import { MeshoptDecoder } from "three/addons/libs/meshopt_decoder.module.js";

    const canvas = document.getElementById(
      "spec-scene",
    ) as HTMLCanvasElement | null;

    if (canvas) {
      const getSize = () => ({
        width: canvas.clientWidth || 1,
        height: canvas.clientHeight || 1,
      });

      let { width, height } = getSize();

      const scene = new THREE.Scene();
      const CAM_DIR = new THREE.Vector3(1, 0, 1).normalize();
      const camera = new THREE.PerspectiveCamera(35, width / height, 0.01, 100);

      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        powerPreference: "high-performance",
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.setSize(width, height, false);
      renderer.outputColorSpace = THREE.SRGBColorSpace;

      // Blueprint palette — mirrors the hero section.
      const EDGE_DARK = new THREE.Color(0xffffff);
      const EDGE_LIGHT = new THREE.Color(0x000000);
      const isLightTheme = () =>
        document.documentElement.dataset.theme === "light";

      const edgeMaterials: THREE.LineBasicMaterial[] = [];

      let modelTarget = new THREE.Vector3();
      let modelSize = new THREE.Vector3();
      let modelLoaded = false;

      const renderScene = () => renderer.render(scene, camera);

      const fitCamera = () => {
        const fovRad = (camera.fov * Math.PI) / 180;
        const aspect = width / height;
        const fitDim = Math.max(modelSize.y, modelSize.x / aspect);
        const dist =
          (fitDim / 2 / Math.tan(fovRad / 2) + modelSize.z / 2) * 1.15;
        camera.position.copy(CAM_DIR).multiplyScalar(dist).add(modelTarget);
        camera.lookAt(modelTarget);
      };

      const loader = new GLTFLoader();
      loader.setMeshoptDecoder(MeshoptDecoder);

      loader.load("/starter-kit/ESK.glb", (gltf) => {
        const model = gltf.scene;

        // Scale and centre — matches the hero section exactly.
        const localBox = new THREE.Box3().setFromObject(model);
        const localSize = new THREE.Vector3();
        localBox.getSize(localSize);
        const maxDim = Math.max(localSize.x, localSize.y, localSize.z) || 1;
        model.scale.setScalar(1.6 / maxDim);

        const scaledBox = new THREE.Box3().setFromObject(model);
        const scaledCenter = new THREE.Vector3();
        scaledBox.getCenter(scaledCenter);
        model.position.sub(scaledCenter);

        // Apply the same yaw as the hero so both sections show the same face.
        const LED_PIVOT = new THREE.Vector3(0, 0.05, 0.05);
        const ROT_AXIS = new THREE.Vector3(0, 1, 0);
        const ROT_ANGLE = Math.PI / 8;
        model.position
          .sub(LED_PIVOT)
          .applyAxisAngle(ROT_AXIS, ROT_ANGLE)
          .add(LED_PIVOT);
        model.rotateOnWorldAxis(ROT_AXIS, ROT_ANGLE);

        scene.add(model);

        // Collect meshes first — adding children inside traverse causes
        // Three.js to visit those children too, which recurses infinitely.
        const meshesToDecorate: THREE.Mesh[] = [];
        model.traverse((obj: THREE.Object3D) => {
          const mesh = obj as THREE.Mesh;
          if (mesh.isMesh) meshesToDecorate.push(mesh);
        });

        // Replace each mesh with blueprint tint fill + edge overlay.
        const masks: { parent: THREE.Mesh; child: THREE.Mesh }[] = [];
        const overlays: { parent: THREE.Mesh; child: THREE.LineSegments }[] =
          [];

        for (const mesh of meshesToDecorate) {
          // Depth-only mask: fills the z-buffer so back-face edges of
          // occluded geometry get depth-rejected. polygonOffset prevents
          // z-fighting with the surface the lines sit on.
          const maskMat = new THREE.MeshBasicMaterial({
            colorWrite: false,
            depthWrite: true,
            polygonOffset: true,
            polygonOffsetFactor: 1,
            polygonOffsetUnits: 1,
          });
          const mask = new THREE.Mesh(mesh.geometry, maskMat);
          mask.renderOrder = -1;
          masks.push({ parent: mesh, child: mask });

          // Clone the original material and zero its opacity — invisible but
          // still writes depth, matching the hero's inactive-module state.
          const src = Array.isArray(mesh.material)
            ? mesh.material[0]
            : mesh.material;
          if (src) {
            const solidMat = (
              src as THREE.Material
            ).clone() as THREE.Material & {
              transparent: boolean;
              opacity: number;
              depthWrite: boolean;
            };
            solidMat.transparent = true;
            solidMat.opacity = 0;
            solidMat.depthWrite = true;
            mesh.material = solidMat;
          }

          // Edge lines at WIRE_DIM (0.3) — matches the hero's inactive state.
          const lineMat = new THREE.LineBasicMaterial({
            color: isLightTheme() ? EDGE_LIGHT : EDGE_DARK,
            transparent: true,
            opacity: 0.3,
            depthWrite: false,
            depthTest: true,
          });
          overlays.push({
            parent: mesh,
            child: new THREE.LineSegments(
              new THREE.EdgesGeometry(mesh.geometry, 30),
              lineMat,
            ),
          });
          edgeMaterials.push(lineMat);
        }

        // Add children only after the loop — same pattern as the hero section.
        for (const { parent, child } of masks) parent.add(child);
        for (const { parent, child } of overlays) parent.add(child);

        model.updateMatrixWorld(true);
        const finalBox = new THREE.Box3().setFromObject(model);
        modelTarget = finalBox.getCenter(new THREE.Vector3());
        modelSize = finalBox.getSize(new THREE.Vector3());

        fitCamera();
        modelLoaded = true;
        renderScene();
      });

      new MutationObserver(() => {
        if (!modelLoaded) return;
        const edge = isLightTheme() ? EDGE_LIGHT : EDGE_DARK;
        for (const m of edgeMaterials) m.color.copy(edge);
        renderScene();
      }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });

      const resize = () => {
        const next = getSize();
        if (next.width === width && next.height === height) return;
        width = next.width;
        height = next.height;
        renderer.setSize(width, height, false);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
        if (modelLoaded) {
          fitCamera();
          renderScene();
        }
      };

      new ResizeObserver(resize).observe(canvas);
    }
  </script>
</section>
