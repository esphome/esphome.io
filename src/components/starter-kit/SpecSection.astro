---
import TitleText from "@components/starter-kit/TitleText.astro";
import SpecItem from "@components/starter-kit/SpecItem.astro";
---

<section id="specs" class="block-specs">
  <TitleText>
    <h2 slot="title" class="title">Specifications</h2>
  </TitleText>

  <div class="container">
    <div class="specs fade-up">
      <div class="specs-col col">
        <div class="spec-title-container">
          <h3 class="spec-title">Product details</h3>
        </div>

        <div class="spec-items">
          <SpecItem title="Main board">
            <li>Espressif ESP32-C6-MINI-1</li>
            <li>Operating temperature: -40 °C to +85 °C</li>
          </SpecItem>
          <SpecItem title="Power and data">
            <li>USB-C, 5 V DC</li>
            <li>Optional power: rechargeable LiPo battery (sold separately)</li>
          </SpecItem>
          <SpecItem title="Connectivity">
            <li>Wi-Fi, Bluetooth LE, Thread</li>
            <li>Zigbee possible at the chip level for advanced users</li>
          </SpecItem>
          <SpecItem title="Module ports">
            <li>2 × 14-pin FPC</li>
          </SpecItem>
          <SpecItem title="Onboard indicators">
            <li>RGB status LED</li>
          </SpecItem>
          <SpecItem title="Configuration software">
            <li>ESPHome Desktop (free download for Mac, Windows, Linux)</li>
            <li>ESPHome add-on for Home Assistant</li>
          </SpecItem>
        </div>

        <div class="spec-title-container">
          <h3 class="spec-title">Module specifications</h3>
          <p>
            Each module connects to the main board with a 14-pin FPC ribbon
            cable. Two modules can run on the main board at the same time.
          </p>
        </div>

        <div class="spec-items">
          <SpecItem title="PIR motion sensor">
            <li>MH-SR602, up to 3.5 m detection range</li>
            <li>Operating temperature: -20 °C to +80 °C</li>
          </SpecItem>
          <SpecItem title="Temperature & humidity">
            <li>AHT20F (±0.3 °C, ±2% RH)</li>
            <li>Operating temperature: -40 °C to +85 °C</li>
          </SpecItem>
          <SpecItem title="Button">
            <li>Tactile pushbutton</li>
            <li>Operating temperature: -25 °C to +85 °C (typical)</li>
          </SpecItem>
          <SpecItem title="Notification module">
            <li>
              ESPHome “Casita” board: 10 × programmable RGB LEDs and piezo
              buzzer
            </li>
            <li>
              Operating temperature: -20 °C to +70 °C (typical for LEDs and
              piezo)
            </li>
          </SpecItem>
          <SpecItem title="Stand">
            <li>Included</li>
          </SpecItem>
          <SpecItem title="Ribbon cables">
            <li>3 × FPC (flexible printed circuit)</li>
            <li>Operating temperature: -40 °C to +85 °C (typical)</li>
          </SpecItem>
        </div>

        <div class="spec-title-container">
          <h3 class="spec-title">Environmental conditions for operation</h3>
        </div>
        <div class="spec-items">
          <SpecItem title="Operating environment">
            <li>Indoor use only</li>
            <li>-20 °C to +70 °C</li>
            <li>-4 °F to +158 °F</li>
            <li>Humidity: non-condensing</li>
            <li>
              (Overall range bound by the narrowest component: the Casita
              module’s RGB LEDs and piezo buzzer)
            </li>
          </SpecItem>
          <SpecItem title="Storage and care">
            <li>
              Keep in a dry, not excessively dusty environment to avoid damage
              to the unit.
            </li>
            <li>
              Do not leave the unit in direct sunlight or near any heat source,
              as this can cause overheating.
            </li>
          </SpecItem>
        </div>

        <div class="spec-title-container">
          <h3 class="spec-title">Device characteristics</h3>
        </div>
        <div class="spec-items">
          <SpecItem title="Dimensions">
            <li>Main board: 35 × 18 × 10 mm</li>
            <li>Module board: 82 × 74 × 10 mm</li>
          </SpecItem>
          <SpecItem title="In the box">
            <li>ESPHome ESP32-C6 main board</li>
            <li>
              ESPHome Starter Kit module board (temperature and humidity sensor,
              button, and ESPHome “Casita” notification modules)
            </li>
            <li>PIR motion sensor</li>
            <li>Stand</li>
            <li>3 × FPC ribbon cables</li>
          </SpecItem>
          <SpecItem title="Material">
            <li>PCB-based open design</li>
          </SpecItem>
        </div>
      </div>
    </div>
    <div class="asset-col col"></div>
  </div>

  <style lang="scss">
    @use "../../styles/mixins" as *;

    .specs {
      width: 100%;
      display: flex;
      flex-direction: row;
      gap: 5rem;
    }

    .specs-col {
      width: 60%;
      flex-grow: 1;
    }

    .asset-col {
      width: 30%;

      position: sticky;
      top: 0;
    }

    .col {
      //
    }

    .spec-title-container {
      margin-top: 2.5rem;
      margin-bottom: 1rem;

      &:first-child {
        margin-top: 0;
      }

      .spec-title {
        @include fluid(20, 24);
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 1.25rem;
      }

      p {
        line-height: 1.3;
        text-wrap: balance;
      }
    }

    .spec-items {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1.25rem 2.5rem;
    }
  </style>
</section>
