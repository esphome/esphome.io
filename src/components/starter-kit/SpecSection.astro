---
import TitleText from "@components/starter-kit/TitleText.astro";
import SpecItem from "@components/starter-kit/SpecItem.astro";
---

<section class="block-specs">
  <TitleText>
    <h2 slot="title" class="title">Specifications</h2>
  </TitleText>

  <div class="container">
    <div class="specs fade-up">
      <div class="specs-col col">
        <div class="spec-title-container">
          <h3 class="spec-title">Product details</h3>
          <p>
            Each module connects to the main board with a 14-pin FPC ribbon
            cable. Two modules can run on the main board at the same time.
          </p>
        </div>

        <div class="spec-items">
          <SpecItem title="Button module">
            <li>Dimensions: 40mm x 40mm x 10mm</li>
            <li>2 mechanical buttons</li>
            <li>1 RGB LED</li>
          </SpecItem>
          <SpecItem title="Button module">
            <li>Dimensions: 40mm x 40mm x 10mm</li>
            <li>2 mechanical buttons</li>
            <li>1 RGB LED</li>
          </SpecItem>
          <SpecItem title="Button module">
            <li>Dimensions: 40mm x 40mm x 10mm</li>
            <li>2 mechanical buttons</li>
            <li>1 RGB LED</li>
          </SpecItem>
        </div>
      </div>
      <div class="asset-col col"></div>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../styles/mixins" as *;

  .specs {
    width: 100%;
    display: flex;
    flex-direction: row;
    gap: 5rem;
  }

  .specs-col {
    width: 60%;
    flex-grow: 1;
  }

  .asset-col {
    width: 30%;

    position: sticky;
    top: 0;
  }

  .col {
    //
  }

  .spec-title-container {
    margin-bottom: 1rem;

    .spec-title {
      @include fluid(20, 24);
      text-transform: uppercase;
      font-weight: 600;
      margin-bottom: 1.25rem;
    }
  }

  .spec-items {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
  }
</style>
