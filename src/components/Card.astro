---
import IconText from "@components/IconText.astro";

const { span, bleed = false, href, delay, ...attrs } = Astro.props;
const hasMedia = Astro.slots.has("media");
const spanValue =
  span === "full" ? "1 / -1" : typeof span === "number" ? `span ${span}` : null;
const delayValue =
  delay !== undefined
    ? typeof delay === "number"
      ? `${delay}ms`
      : delay
    : null;

const Tag = href ? "a" : "div";

const { line = false, direction = "horizontal" } = Astro.props;
---

<Tag
  class:list={[
    "card",
    "fade-up",
    {
      "card--with-media": hasMedia,
      "card--bleed": bleed && hasMedia,
      "card--link": !!href,
      "card--line": line,
    },
  ]}
  style={{ "--card-span": spanValue, "--fade-delay": delayValue }}
  href={href}
  {...attrs}
>
  {
    line && (
      <div class="card__line" aria-hidden="true">
        <div class="card__line-pulse" />
      </div>
    )
  }
  {
    hasMedia && (
      <div class="card__media">
        <slot name="media" />
      </div>
    )
  }
  <div class="card__content">
    <slot />
  </div>
  {
    href && (
      <span class="card__arrow" aria-hidden="true">
        <IconText icon="arrow_outward" />
      </span>
    )
  }
</Tag>

<style lang="scss">
  @use "../styles/mixins" as *;

  .card {
    border: 1px solid var(--esk-primary-color);
    border-radius: 8px;
    @include fluid(16, 32, $property: padding);

    display: flex;
    flex-direction: column;

    background: var(--esk-card-background);

    grid-column: var(--card-span, auto);
    position: relative;
    transition: border-color 0.2s ease;

    &:hover {
      border-color: var(--esk-title-colour);

      :global(.is-animated.playing *) {
        animation-iteration-count: infinite;
      }
    }

    @include bp(tablet) {
      border-radius: 12px;
    }

    :global(h3) {
      margin-top: 1.75rem;
      margin-bottom: 0.5rem;

      @include bp(tablet) {
        margin-top: 2.75rem;
        margin-bottom: 0.75rem;
      }

      &.no-mt {
        margin-top: 0;
      }
    }

    :global(p) {
      @include fluid(12, 16);
      line-height: 1.2;
    }

    :global(ul) {
      padding: 0 0 0 1.75rem;

      :global(li) {
        line-height: 1.3;
        margin-bottom: 1rem;

        &:last-child {
          margin-bottom: 0;
        }

        &::marker {
          color: var(--esk-primary-color);
        }
      }
    }
  }

  .card__line {
    width: 24px;
    height: 1px;
    background: var(--esk-primary-color);

    position: absolute;
    top: 100%;
    left: 50%;
    transform: rotate(90deg);
    transform-origin: top left;

    @include bp(tablet) {
      top: 50%;
      left: 100%;
      transform: rotate(0);
    }

    &:before,
    &:after {
      width: 0.5rem;
      height: 0.5rem;
      content: "";
      background-color: var(--esk-primary-color);
      border-radius: 50%;
      position: absolute;
      top: 50%;
    }

    &:before {
      left: 1px;
      transform: translate(-50%, -55%);

      @include bp(tablet) {
        transform: translate(-50%, -50%);
      }
    }

    &:after {
      right: -1px;
      transform: translate(50%, -55%);

      @include bp(tablet) {
        transform: translate(50%, -50%);
      }
    }

    &-pulse {
      position: absolute;
      top: 50%;
      left: calc(100% + 1px);
      width: 1rem;
      height: 1rem;
      border: 2px solid var(--esk-primary-color);
      border-radius: 50%;
      transform: translate(-50%, -50%) scale(1);
      opacity: 0;
      pointer-events: none;

      .card.in-view & {
        animation: card-line-pulse 1s ease-out forwards;
        animation-delay: var(--fade-delay, 0ms);
      }

      @keyframes card-line-pulse {
        0% {
          transform: translate(-50%, -50%) scale(0.4);
          opacity: 0.7;
        }
        100% {
          transform: translate(-50%, -50%) scale(3);
          opacity: 0;
        }
      }
    }
  }

  .card--link {
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;

    &:hover,
    &:focus-visible {
      border-color: var(--esk-title-colour);

      .card__arrow {
        :global(.icon-text .icon svg) {
          transform: translate(3px, -3px);
        }
      }
    }
  }

  .card__arrow {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: block;

    pointer-events: none;

    @include bp(tablet) {
      top: 1.5rem;
      right: 1.5rem;
    }

    :global(.icon-text .icon svg) {
      width: 14px;
      height: 14px;
      transition: transform 0.2s ease;
    }
  }

  .card__media {
    overflow: hidden;
    position: relative;

    :global(img),
    :global(svg),
    :global(picture) {
      width: 100%;
      height: auto;
      display: flex;
    }

    :global(video) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .card--with-media {
    min-height: 342px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;

    @include bp(tablet) {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 2rem;

      .card__media {
        position: relative;
        min-height: 100%;

        :global(img),
        :global(svg),
        :global(picture) {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          object-fit: cover;
        }

        :global(img.contain) {
          object-fit: contain;
        }
      }
    }

    :global(h2),
    :global(h3) {
      @include bp(tablet) {
        margin-top: 0;
      }
    }
  }

  .card--bleed {
    overflow: hidden;
    padding: 0;

    .card__content {
      @include fluid(16, 32, $property: padding);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".card").forEach((card) => {
    card.addEventListener("mouseenter", () => {
      card.querySelectorAll<SVGElement>(".is-animated").forEach((icon) => {
        icon.classList.remove("playing");
        void icon.offsetWidth;
        icon.classList.add("playing");
      });
    });
  });
</script>
