---
/**
 * PageTitle override
 *
 * The homepage renders its own <h1> inside its custom Hero markup, so Starlight's default
 * page title (the h1#_top normally shown above the content) is suppressed there. The starter
 * kit pages also hide the default title.
 */
import Default from "@astrojs/starlight/components/PageTitle.astro";

const hideTitle = Astro.url.pathname.startsWith("/starter-kit") || Astro.url.pathname === "/";
---

{!hideTitle ? <Default {...Astro.props} /> : <div class="no-page-title" />}
