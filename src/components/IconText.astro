---
import { iconData, type Icon } from "src/lib/icons";
import { animatedIconData, type AnimatedIcon } from "src/lib/animated-icons";

interface Props {
  icon?: Icon;
  animated?: AnimatedIcon;
  delay?: number | string;
  text?: string;
}

const { icon, animated, delay, text } = Astro.props;
const delayValue = delay !== undefined ? { "--animation-delay": typeof delay === "number" ? `${delay}ms` : delay } : {};
const { viewBox, body } = animated
  ? animatedIconData[animated]
  : icon
    ? iconData[icon]
    : { viewBox: "0 0 24 24", body: "" };
---

<div class="icon-text">
  {
    (icon || animated) && (
      <div class="icon">
        <svg
          viewBox={viewBox}
          fill="currentColor"
          aria-hidden="true"
          class:list={[{ "is-animated": animated }]}
          style={delayValue}
          set:html={body}
        />
      </div>
    )
  }
  {text && <div class="text">{text}</div>}
</div>

<style lang="scss">
  @use "../styles/mixins" as *;

  .icon-text {
    display: flex;
    gap: 12px;

    // Default (dark mode): solid muted-olive background.
    --icon-text-bg: rgba(49, 57, 32, 0.6);

    :global([data-theme="light"]) & {
      // Light mode: solid pale-green so labels stay legible on light pages.
      --icon-text-bg: rgba(220, 228, 197, 0.6);
    }

    .icon,
    .text {
      height: 40px;
      border-radius: 4px;
      border: 1px solid var(--esk-primary-color);
      background-color: var(--icon-text-bg);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: grid;
      margin-top: 0;
      padding: 0 10px;
      place-items: center;
    }

    .icon {
      width: 2.5rem;
      display: grid;
      place-items: center;
      color: var(--esk-title-colour);

      svg {
        width: 100%;
        height: 100%;
        max-height: 18px;
        max-width: 18px;
      }
    }

    .text {
      padding-right: 1rem;
      padding-left: 1rem;
      color: var(--esk-title-colour);
      font-size: 0.75rem;
      text-transform: uppercase;
      font-weight: 700;
      flex-shrink: 0;

      @include bp(tablet) {
        padding-right: 1.25rem;
        padding-left: 1.25rem;
      }
    }
  }
</style>

