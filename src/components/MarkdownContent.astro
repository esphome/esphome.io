---
// Wraps starlight-blog's MarkdownContent override so blog posts keep their
// cover, metadata, tags and prev/next links, then appends a Discourse comments
// section at the very bottom of each post. The comments are only rendered on
// actual blog post pages (not the blog index, tag or author listings, or
// paginated pages); this mirrors starlight-blog's isAnyBlogPostPage.
import StarlightBlogMarkdownContent from "starlight-blog/overrides/MarkdownContent.astro";
import DiscourseComments from "./DiscourseComments.astro";

const { id } = Astro.locals.starlightRoute;
const isBlogPost = /^blog\/(?!(\d+\/?|tags\/.+|authors\/.+)$).+$/.test(id);
---

<StarlightBlogMarkdownContent>
  <slot />
</StarlightBlogMarkdownContent>
{isBlogPost && <DiscourseComments />}
