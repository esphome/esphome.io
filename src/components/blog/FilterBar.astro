---
/**
 * Filter bar for the blog listing pages: the active filters as removable chips with the number of
 * matching posts, and a "Filters" button that opens a drawer with every category, year and author.
 * The drawer's lists show what each choice gives from the current page, so a category's years, or
 * a year's categories, combine the two. It slides in from the right on wide screens and up from
 * the bottom as a sheet on narrow ones.
 *
 * Every filter is a plain link to its own static listing (see src/lib/blog.ts), so filtered views
 * are shareable and work without JavaScript.
 */
import type { DrawerItem, ListingPage } from "../../lib/blog";

interface Props {
  listing: ListingPage;
}

const { listing } = Astro.props;
const { activeFilters, count, drawer } = listing;
const ariaCurrent = (item: DrawerItem) => (item.current ? "page" : undefined);
---

<div class="blog-toolbar">
  <div class="active-filters">
    {activeFilters.length === 0 ? (
      <span class="chip">
        All posts <span class="count">{count}</span>
      </span>
    ) : (
      <>
        {activeFilters.map((filter) => (
          <a class="chip" href={filter.removeHref} aria-label={`Remove filter ${filter.name}: ${filter.label}`}>
            <span>
              <span class="prefix">{filter.name}:</span> {filter.label}
            </span>
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </a>
        ))}
        <span class="result-count">
          {count} {count === 1 ? "post" : "posts"}
        </span>
        {activeFilters.length > 1 && (
          <a class="clear" href="/blog/">
            Clear filters
          </a>
        )}
      </>
    )}
  </div>
  <div class="actions">
    <button type="button" class="filters-button" commandfor="blog-filters" command="show-modal">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          d="M4 6h16M7 12h10M10 18h4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></path>
      </svg>
      Filters
    </button>
    <a class="rss" href="/blog/rss.xml">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        ></path>
        <circle cx="5" cy="19" r="1.5" fill="currentColor"></circle>
      </svg>
      <span>RSS</span>
    </a>
  </div>
</div>

<dialog id="blog-filters" class="filters-drawer" closedby="any" aria-labelledby="blog-filters-title">
  <header class="drawer-header">
    <h2 id="blog-filters-title">Filter posts</h2>
    <button type="button" class="close" commandfor="blog-filters" command="close" aria-label="Close filters">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </header>
  <div class="drawer-body">
    <section>
      <h3>Category</h3>
      <ul class="rows">
        {[drawer.allTags, ...drawer.topTags].map((item) => (
          <li>
            <a href={item.href} aria-current={ariaCurrent(item)}>
              <span class="label">{item.label}</span>
              <span class="count">{item.count}</span>
            </a>
          </li>
        ))}
      </ul>
      {drawer.moreTags.length > 0 && (
        <details class="more" open={drawer.moreOpen}>
          <summary>More categories</summary>
          <ul class="rows">
            {drawer.moreTags.map((item) => (
              <li>
                <a href={item.href} aria-current={ariaCurrent(item)}>
                  <span class="label">{item.label}</span>
                  <span class="count">{item.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}
    </section>
    <section>
      <h3>Year</h3>
      <ul class="pills">
        {[drawer.allYears, ...drawer.years].map((item) => (
          <li>
            <a href={item.href} aria-current={ariaCurrent(item)}>
              {item.label}
              <span class="count">{item.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
    <section>
      <h3>Author</h3>
      <ul class="rows">
        {drawer.authors.map((item) => (
          <li>
            <a href={item.href} aria-current={ariaCurrent(item)}>
              {item.picture ? (
                <img class="avatar" src={item.picture} alt="" width="24" height="24" loading="lazy" />
              ) : (
                <span class="avatar" aria-hidden="true" />
              )}
              <span class="label">{item.label}</span>
              <span class="count">{item.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
  <footer class="drawer-footer">
    {activeFilters.length > 0 ? <a href="/blog/">Clear filters</a> : <span />}
    <button type="button" class="done" commandfor="blog-filters" command="close">
      Done
    </button>
  </footer>
</dialog>

<script>
  // Invoker commands (commandfor/command) open and close the drawer natively. Browsers without
  // them get the same behaviour from click handlers.
  if (!("commandForElement" in HTMLButtonElement.prototype)) {
    document.addEventListener("click", (event) => {
      const button = (event.target as Element | null)?.closest<HTMLButtonElement>("button[commandfor]");
      if (!button) return;
      const dialog = document.getElementById(button.getAttribute("commandfor") ?? "");
      if (!(dialog instanceof HTMLDialogElement)) return;
      const command = button.getAttribute("command");
      if (command === "show-modal") dialog.showModal();
      else if (command === "close") dialog.close();
    });
  }

  // closedby="any" closes the drawer on a backdrop click; Safari does not support it yet.
  if (!("closedBy" in HTMLDialogElement.prototype)) {
    const dialog = document.getElementById("blog-filters") as HTMLDialogElement | null;
    dialog?.addEventListener("click", (event) => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      const inside =
        rect.top <= event.clientY &&
        event.clientY <= rect.bottom &&
        rect.left <= event.clientX &&
        event.clientX <= rect.right;
      if (!inside) dialog.close();
    });
  }
</script>

<style>
  .blog-toolbar {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .active-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    min-width: 0;
  }

  /* Active filters are high-contrast "ink" chips: --sl-color-white is the strongest text colour in
     both themes, so the chip is dark on the light theme and light on the dark one. */
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    background: var(--sl-color-white);
    color: var(--sl-color-black);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .chip .prefix,
  .chip .count {
    opacity: 0.7;
  }

  .chip .count {
    font-size: var(--sl-text-xs);
  }

  .chip svg {
    flex-shrink: 0;
  }

  a.chip:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .result-count {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .clear,
  .drawer-footer a {
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }

  /* Hover styles only where a pointer can hover; touch browsers keep :hover on the last tapped
     element, which left a drawer row highlighted after the sheet opened. */
  @media (hover: hover) {
    a.chip:hover {
      background: var(--sl-color-text-accent);
      color: var(--sl-color-text-invert);
    }

    .filters-button:hover,
    .rss:hover {
      border-color: var(--sl-color-text-accent);
    }

    .close:hover {
      color: var(--sl-color-white);
    }

    .drawer-body a:not([aria-current="page"]):hover,
    .more summary:hover {
      background: var(--sl-color-gray-6);
      color: var(--sl-color-white);
    }
  }

  .actions {
    display: flex;
    flex-shrink: 0;
    gap: 0.5rem;
    margin-inline-start: auto;
  }

  .filters-button,
  .rss {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }

  @media (max-width: 40rem) {
    .blog-toolbar {
      flex-direction: column-reverse;
      flex-wrap: nowrap;
      align-items: stretch;
    }

    .actions {
      margin-inline-start: 0;
    }

    .filters-button {
      flex-grow: 1;
      justify-content: center;
    }

    .rss span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* A modal dialog does not stop the page behind it from scrolling, so lock it while the drawer is
     open. scrollbar-gutter keeps the layout from shifting when the scrollbar goes away. */
  :global(html:has(#blog-filters[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  /* Drawer: a side sheet on wide screens, a bottom sheet on narrow ones. */
  .filters-drawer {
    width: min(24rem, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0;
    border: 0;
    border-inline-start: 1px solid var(--sl-color-hairline-light);
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    overscroll-behavior: contain;
    box-shadow: var(--sl-shadow-lg);
    opacity: 0;
    transition-property: opacity, transform, display, overlay;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    transition-behavior: allow-discrete;
  }

  .filters-drawer[open] {
    display: flex;
    flex-direction: column;
    opacity: 1;

    @starting-style {
      opacity: 0;
    }
  }

  .filters-drawer::backdrop {
    overflow: hidden;
    overscroll-behavior: contain;
    background-color: rgb(0 0 0 / 0);
    transition-property: background-color, display, overlay;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    transition-behavior: allow-discrete;
  }

  .filters-drawer[open]::backdrop {
    background-color: rgb(0 0 0 / 0.5);

    @starting-style {
      background-color: rgb(0 0 0 / 0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .filters-drawer {
      transform: translateX(100%);
    }

    .filters-drawer[open] {
      transform: none;

      @starting-style {
        transform: translateX(100%);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .filters-drawer,
    .filters-drawer::backdrop {
      transition-duration: 0.1s;
    }
  }

  @media (max-width: 40rem) {
    .filters-drawer {
      width: 100vw;
      height: auto;
      max-height: 85dvh;
      margin: auto 0 0;
      border-inline-start: 0;
      border-top: 1px solid var(--sl-color-hairline-light);
      border-radius: 1rem 1rem 0 0;
    }

    @media (prefers-reduced-motion: no-preference) {
      .filters-drawer {
        transform: translateY(100%);
      }

      .filters-drawer[open] {
        transform: none;

        @starting-style {
          transform: translateY(100%);
        }
      }
    }
  }

  .drawer-header,
  .drawer-footer {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
  }

  .drawer-header {
    border-bottom: 1px solid var(--sl-color-hairline-light);
  }

  .drawer-header h2 {
    margin: 0;
    font-size: var(--sl-text-lg);
  }

  .close {
    display: grid;
    place-items: center;
    padding: 0.25rem;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }

  /* The list scrolls; the header and the footer actions stay in reach. */
  .drawer-body {
    flex-grow: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.5rem 1.25rem 1rem;
  }

  .drawer-body h3 {
    margin: 1rem 0 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .drawer-body ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .drawer-body a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: 0.5rem;
    color: var(--sl-color-gray-1);
    text-decoration: none;
  }

  .rows a {
    padding: 0.625rem 0.75rem;
  }

  .drawer-body a[aria-current="page"] {
    background: var(--sl-color-text-accent);
    color: var(--sl-color-text-invert);
  }

  .drawer-body .label {
    flex-grow: 1;
    min-width: 0;
  }

  .drawer-body .count {
    font-size: var(--sl-text-sm);
    opacity: 0.7;
  }

  /* Categories past the first few: a disclosure, closed unless the current one is inside. */
  .more summary {
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pills a {
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 999px;
  }

  .pills a[aria-current="page"] {
    border-color: var(--sl-color-text-accent);
  }

  .pills .count {
    font-size: var(--sl-text-xs);
  }

  /* Avatar, or a plain grey circle for an author without one. */
  .avatar {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--sl-color-gray-5);
  }

  .drawer-footer {
    border-top: 1px solid var(--sl-color-hairline-light);
  }

  .done {
    padding: 0.5rem 1.25rem;
    border: 0;
    border-radius: 0.5rem;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-text-invert);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
</style>
