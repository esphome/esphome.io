---
/**
 * GettingStartedGrid Component
 * Creates a grid of getting started cards with icons, descriptions, and action buttons.
 *
 * Usage in MDX:
 * <GettingStartedGrid items={[
 *   {
 *     icon: "home-assistant",
 *     title: "From Home Assistant",
 *     description: "The easiest way to get started",
 *     url: "/guides/getting_started_hassio/",
 *     button_text: "Home Assistant Guide"
 *   },
 * ]} />
 *
 * Pass `includeLatestBlogPost` to append a card linking to the most recently published blog post.
 */

import { getCollection } from "astro:content";

interface GettingStartedItem {
  icon: string;
  title: string;
  description: string;
  url?: string;
  button_text?: string;
  steps?: string[];
}

interface Props {
  items: GettingStartedItem[];
  includeLatestBlogPost?: boolean;
}

const { items, includeLatestBlogPost } = Astro.props;

function getIconPath(icon: string): string {
  return `/images/icons/${icon}.svg`;
}

let allItems = items;

if (includeLatestBlogPost) {
  const posts = await getCollection("docs", (entry) => entry.id.startsWith("blog/") && Boolean(entry.data.date));
  const [latest] = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  if (latest) {
    allItems = [
      ...items,
      {
        icon: "edit",
        title: "Latest from the Blog",
        description: `${latest.data.title} — ${latest.data.excerpt ?? latest.data.description ?? ""}`,
        url: `/${latest.id}/`,
        button_text: "Read the Post",
      },
    ];
  }
}
---

<div class="getting-started-grid">
  {
    allItems.map((item) => (
      <div class="feature-card">
        <div class="feature-icon">
          <img src={getIconPath(item.icon)} alt="" loading="lazy" />
        </div>
        <div class="getting-started-heading">{item.title}</div>
        <p>{item.description}</p>
        {item.steps && item.steps.length > 0 && (
          <ol>
            {item.steps.map((step) => (
              <li set:html={step} />
            ))}
          </ol>
        )}
        {item.url && (
          <a href={item.url} class="btn btn-primary">
            {item.button_text}
          </a>
        )}
      </div>
    ))
  }
</div>
