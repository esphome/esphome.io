---
/**
 * GettingStartedGrid Component
 * Creates a grid of getting started cards with icons, titles, descriptions, and buttons.
 *
 * Usage:
 *   <GettingStartedGrid items={[
 *     {
 *       icon: "home-assistant",
 *       title: "From Home Assistant",
 *       description: "The easiest way to get started.",
 *       steps: [],
 *       url: "/guides/getting_started_hassio/",
 *       button_text: "Home Assistant Guide"
 *     }
 *   ]} />
 */

interface GettingStartedItem {
  icon: string;
  title: string;
  description: string;
  steps?: string[];
  url?: string;
  button_text?: string;
}

interface Props {
  items: GettingStartedItem[];
}

const { items } = Astro.props;

// Icon SVG paths
const iconMap: Record<string, string> = {
  'home-assistant': 'M12 3L2 12h3v9h14v-9h3L12 3z',
  'terminal': 'M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  'puzzle-piece': 'M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z',
};

function isFaIcon(icon: string): boolean {
  return icon.startsWith('fa-');
}
---

<div class="getting-started-grid">
  {items.map((item) => (
    <div class="feature-card">
      <div class="feature-icon">
        {isFaIcon(item.icon) ? (
          <i aria-hidden="true" class={`fas ${item.icon}`}></i>
        ) : iconMap[item.icon] ? (
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d={iconMap[item.icon]} />
          </svg>
        ) : (
          <img src={`/images/icons/${item.icon}.svg`} alt="" aria-hidden="true" />
        )}
      </div>
      <div class="getting-started-heading">{item.title}</div>
      <p set:html={item.description} />
      {item.steps && item.steps.length > 0 && (
        <ol>
          {item.steps.map((step) => (
            <li set:html={step} />
          ))}
        </ol>
      )}
      {item.url && (
        <a href={item.url} class="btn btn-primary">{item.button_text || 'Learn More'}</a>
      )}
    </div>
  ))}
</div>
