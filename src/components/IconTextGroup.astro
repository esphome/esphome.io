---
interface Props {
  line?: Boolean;
  direction?: "horizontal" | "vertical";
}

const { line = false, direction = "horizontal" } = Astro.props;
---

<div class={`icon-text-group ${direction} ${line ? "line" : ""}`}>
  <slot />
</div>

<style lang="scss">
  @use "../styles/mixins" as *;

  .icon-text-group {
    display: flex;
    flex-direction: column;
    gap: 2rem;

    @include bp(tablet) {
      gap: 2.5rem;
    }
  }
</style>
