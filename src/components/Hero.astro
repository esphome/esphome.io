---
/**
 * Hero override
 *
 * Starlight's default hero places the image beside the text. Per the homepage redesign notes
 * ("ESPHome Website Tweaks"), the hero image instead sits full-bleed behind the text with a dark
 * overlay for contrast, matching a typical marketing hero banner.
 */
import { Image } from "astro:assets";
import { LinkButton } from "@astrojs/starlight/components";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};

const heroImage = image && "file" in image ? image.file : undefined;
const heroImageAlt = image?.alt || "";
---

<div class="hero">
  {
    heroImage && (
      <Image
        src={heroImage}
        alt={heroImageAlt}
        class="hero-bg"
        layout="full-width"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    )
  }
  <div class="hero-content sl-flex">
    <div class="sl-flex copy">
      <h1 id="_top" data-page-title set:html={title} />
      {tagline && <div class="tagline" set:html={tagline} />}
    </div>
    {
      actions.length > 0 && (
        <div class="sl-flex actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
              {icon?.html && <Fragment set:html={icon.html} />}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>
</div>

<style>
  .hero {
    max-width: 120rem;
    min-height: 30rem;
    position: relative;
    display: flex;
    align-items: center;
    isolation: isolate;
    overflow: hidden;
    margin: 0 auto;
  }

  .hero:after {
    width: 100%;
    height: 100%;
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.78) 100%);
    z-index: 5;
  }

  .hero-bg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate3d(-50%, -50%, 0);
  }

  .hero-content {
    width: 100%;
    max-width: 67.5rem;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
    text-align: center;
    margin: 0 auto;
    padding: 0 var(--sl-content-pad-x);
    z-index: 10;
  }

  .copy {
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .tagline {
    font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
    color: var(--sl-color-gray-1);
  }

  .actions {
    gap: 1rem 2rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (min-width: 50rem) {
    .hero-content {
      text-align: start;
      align-items: flex-start;
    }

    .copy {
      align-items: flex-start;
    }

    .actions {
      justify-content: flex-start;
    }
  }
</style>
