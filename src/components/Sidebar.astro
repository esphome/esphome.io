---
import TOC from './TOC.astro';

interface Props {
  headings?: Array<{ depth: number; slug: string; text: string }>;
  editUrl?: string | null;
}

const { headings = [], editUrl } = Astro.props;
---

<div class="sidebar-content scroll-trap">
  {headings.length > 0 && (
    <>
      <div class="sidebar-nav">
        <h3 style="position: relative;">
          On this page
          <button class="toc-sort-button" aria-label="Toggle sort order" title="Toggle alphabetic/linear sort">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 6h18M3 12h12M3 18h6"/>
            </svg>
          </button>
        </h3>
        <TOC headings={headings} />
      </div>
      <hr class="toc-separator" />
    </>
  )}

  <slot />

  {editUrl && (
    <div class="sidebar-resource">
      <a href={editUrl} target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="16" height="16">
          <path fill="currentColor" d="M471.6 21.7c-21.9-21.9-57.3-21.9-79.2 0L362.3 51.7l97.9 97.9 30.1-30.1c21.9-21.9 21.9-57.3 0-79.2L471.6 21.7zm-299.2 220c-6.1 6.1-10.8 13.6-13.5 21.9l-29.6 88.8c-2.9 8.6-.6 18.1 5.8 24.6s15.9 8.7 24.6 5.8l88.8-29.6c8.2-2.8 15.7-7.4 21.9-13.5L680 phases.3 97.9-97.9L269.4 144.7 172.4 241.7zM96 64C43 64 0 107 0 160V416c0 53 43 96 96 96H352c53 0 96-43 96-96V320c0-17.7-14.3-32-32-32s-32 14.3-32 32v96c0 17.7-14.3 32-32 32H96c-17.7 0-32-14.3-32-32V160c0-17.7 14.3-32 32-32h96c17.7 0 32-14.3 32-32s-14.3-32-32-32H96z"/>
        </svg>
        Edit this page on GitHub
      </a>
    </div>
  )}
</div>

<script>
  // TOC sort toggle functionality
  document.addEventListener('DOMContentLoaded', () => {
    const sortBtn = document.querySelector('.toc-sort-button');
    if (!sortBtn) return;

    sortBtn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-toc-sort');
      const newSort = current === 'alphabetic' ? 'linear' : 'alphabetic';
      document.documentElement.setAttribute('data-toc-sort', newSort);
      localStorage.setItem('toc-sort', newSort);
    });
  });
</script>
