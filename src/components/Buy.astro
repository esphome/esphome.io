---
import {
  regions as defaultRegions,
  type Region,
} from "src/data/starter-kit/regions";

interface Props {
  strapline?: string;
  dollars?: string | number;
  euros?: string | number;
  regions?: Region[];
}

const {
  strapline,
  dollars,
  euros,
  regions = defaultRegions,
}: Props = Astro.props;
---

<section id="buy" class="block-buy fade-up">
  <div class="section-inner">
    <div class="section-inner-content">
      <div class="container">
        <div class="content">
          <div class="strap">
            {strapline}
          </div>
          <h2 class="price">
            <sub>$</sub>{dollars}<span>/</span><sub>€</sub>{euros}<sup>*</sup>
          </h2>
          <button class="buy btn btn-primary esk-btn" data-buy-open
            >Buy now</button
          >
        </div>
        <p class="terms">
          *Recommended MSRP. Prices differ between regions due to varying local
          market costs and conditions, and subject to individual retailers.
        </p>
      </div>
    </div>
  </div>

  <dialog class="buy-dialog" id="buy-dialog" aria-labelledby="buy-dialog-title">
    <div class="buy-dialog__inner">
      <header class="buy-dialog__header">
        <h3 id="buy-dialog-title">Choose your region</h3>
        <button
          class="buy-dialog__close"
          type="button"
          aria-label="Close"
          data-buy-close>&times;</button
        >
      </header>

      <p class="buy-dialog__intro">
        The Starter Kit ships from Apollo Automation directly and through
        regional distributors. Pick the option closest to you.
      </p>

      <div class="buy-dialog__regions">
        {
          regions.map((region) => (
            <section
              class="buy-region"
              data-countries={region.countries.join(",")}
            >
              <h4>{region.label}</h4>
              {region.direct.length > 0 && (
                <>
                  <p class="buy-region__label">Buy direct from Apollo</p>
                  <ul>
                    {region.direct.map((s) => (
                      <li>
                        <a
                          href={s.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {s.name}
                        </a>
                        {s.note && (
                          <span class="buy-region__note">{s.note}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </>
              )}
              {region.distributors.length > 0 && (
                <>
                  <p class="buy-region__label">Local distributors</p>
                  <ul>
                    {region.distributors.map((s) => (
                      <li>
                        <a
                          href={s.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {s.name}
                        </a>
                        {s.note && (
                          <span class="buy-region__note">{s.note}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </>
              )}
              {region.direct.length === 0 &&
                region.distributors.length === 0 && (
                  <p class="buy-region__empty">Coming soon.</p>
                )}
            </section>
          ))
        }
      </div>
    </div>
  </dialog>
</section>

<script>
  const dialog = document.getElementById(
    "buy-dialog",
  ) as HTMLDialogElement | null;
  if (dialog) {
    document.querySelectorAll<HTMLElement>("[data-buy-open]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        if (typeof dialog.showModal === "function") dialog.showModal();
        else dialog.setAttribute("open", "");
      });
    });
    dialog.querySelectorAll<HTMLElement>("[data-buy-close]").forEach((btn) => {
      btn.addEventListener("click", () => dialog.close());
    });
    // Click outside the inner card closes the dialog.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }

  // Any in-page "Buy now" link (e.g. the nav CTA) should open the dialog
  // instead of jumping to #buy, so the user lands directly on the regional
  // store list.
  document
    .querySelectorAll<HTMLAnchorElement>('a[href="#buy"]')
    .forEach((a) => {
      a.addEventListener("click", (event) => {
        if (!dialog) return;
        event.preventDefault();
        if (typeof dialog.showModal === "function") dialog.showModal();
        else dialog.setAttribute("open", "");
      });
    });
</script>

<style lang="scss">
  @use "../styles/mixins" as *;

  :root {
    --esk-buy-terms-bg: transparent;
  }

  :root[data-theme="light"] {
    --esk-buy-terms-bg: rgba(241, 241, 241, 0.5);
  }

  section#buy {
    margin: 0 auto;

    .cols {
      align-items: center;
      justify-content: center;
    }

    .container {
      display: flex;
      justify-content: center;
      text-align: center;
      flex-direction: column;
      align-items: center;
      gap: 40px;
      padding-top: 5rem;

      @include bp(desktop) {
        padding-top: 0;
      }
    }

    .section-inner {
      position: relative;
      z-index: 1;

      @include bp(desktop) {
        z-index: unset;
        position: relative;
      }
    }

    .section-inner-content {
      align-items: center;
      justify-content: center;
      padding: 0;
    }

    .strap {
      @include fluid(24, 32);
      text-wrap: balance;
      position: relative;
      z-index: 2;
      color: var(--esk-title-colour);

      @include bp(tablet) {
        font-size: 24px;
      }

      @include bp(desktop) {
        font-size: 32px;
      }
    }

    .price {
      @include fluid(64, 128);
      font-weight: 700;
      margin: 16px 0;
      position: relative;

      span {
        opacity: 0.4;
        position: relative;
      }

      sup {
        font-size: 36px;
        vertical-align: unset;
        position: absolute;
        top: 25%;
        line-height: 1;
        margin: 0;
      }

      sub {
        vertical-align: initial;
        bottom: 0;
        margin-right: 6px;
        @include fluid(36, 96);
      }
    }

    .btn {
      margin-top: 1rem;
      cursor: pointer;
    }

    .terms {
      max-width: 445px;
      background-color: var(--esk-buy-terms-bg);
      border-radius: 8px;
      padding: 12px 16px;
      font-size: 12px;
      line-height: 1.3;
      color: var(--esk-body-colour);
      margin: 0;
      text-wrap: balance;
    }
  }

  .buy-dialog {
    border: none;
    padding: 0;
    background: transparent;
    color: inherit;
    max-width: 560px;
    width: calc(100% - 2rem);
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);

    &::backdrop {
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(4px);
    }

    &__inner {
      background: var(--esk-card-background, #fff);
      border: 1px solid var(--esk-primary-color, #002e3e);
      border-radius: 16px;
      padding: 1.5rem;
      max-height: 80vh;
      overflow-y: auto;
      color: var(--esk-body-colour, #002e3e);
    }

    &__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 0.75rem;

      h3 {
        margin: 0;
        @include fluid(20, 24);
        color: var(--esk-title-colour, #002e3e);
      }
    }

    &__close {
      background: transparent;
      border: 1px solid var(--esk-primary-color, #002e3e);
      color: var(--esk-title-colour, #002e3e);
      width: 32px;
      height: 32px;
      border-radius: 50%;
      font-size: 1.5rem;
      line-height: 1;
      cursor: pointer;

      &:hover {
        background: var(--esk-primary-color--light, rgba(0, 46, 62, 0.1));
      }
    }

    &__intro {
      margin: 0 0 1rem;
      font-size: 0.875rem;
      line-height: 1.4;
      color: var(--esk-body-colour, #002e3e);
    }

    &__regions {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
  }

  .buy-region {
    border-top: 1px solid var(--esk-primary-color, #002e3e);
    padding-top: 1rem;

    h4 {
      margin: 0 0 0.5rem;
      @include fluid(16, 18);
      color: var(--esk-title-colour, #002e3e);
    }

    &__label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-weight: 700;
      margin: 0.75rem 0 0.25rem;
      color: var(--esk-body-colour, #002e3e);
      opacity: 0.7;
    }

    &__note {
      font-size: 0.75rem;
      opacity: 0.7;
      margin-left: 0.5rem;
    }

    &__empty {
      margin: 0;
      font-size: 0.875rem;
      opacity: 0.7;
      font-style: italic;
    }

    ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;

      li {
        margin: 0;
      }

      a {
        color: var(--esk-title-colour, #002e3e);
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 3px;

        &:hover {
          text-decoration-thickness: 2px;
        }
      }
    }
  }
</style>
