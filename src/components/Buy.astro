---
interface Props {
  strapline?: string;
  dollars?: string | number;
  euros?: string | number;
}

const { strapline, dollars, euros }: Props = Astro.props;
---

<section id="buy" class="block-buy fade-up">
  <div class="section-inner">
    <div class="section-inner-content">
      <div class="container">
        <div class="content">
          <div class="strap">
            {strapline}
          </div>
          <h2 class="price">
            <sub>$</sub>{dollars}<span>/</span>{euros}<sub>€</sub><sup>*</sup>
          </h2>
          <button class="buy btn btn-primary esk-btn">Buy now</button>
        </div>
        <p class="terms">
          *Recommended MSRP. Prices differ between regions due to varying local market costs and conditions, and subject
          to individual retailers.
        </p>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../styles/mixins" as *;

  :root {
    --esk-buy-terms-bg: transparent;
  }

  :root[data-theme="light"] {
    --esk-buy-terms-bg: rgba(241, 241, 241, 0.5);
  }

  section#buy {
    margin: 0 auto;

    .cols {
      align-items: center;
      justify-content: center;
    }

    .container {
      display: flex;
      justify-content: center;
      text-align: center;
      flex-direction: column;
      align-items: center;
      gap: 40px;
      padding-top: 2.5rem;

      @include bp(desktop) {
        padding-top: 0;
      }
    }

    .section-inner {
      position: relative;
      z-index: 1;

      @include bp(desktop) {
        z-index: unset;
        position: relative;
      }
    }

    .section-inner-content {
      align-items: center;
      justify-content: center;
      padding: 0;
    }

    .strap {
      @include fluid(24, 32);
      text-wrap: balance;
      position: relative;
      z-index: 2;
      color: var(--esk-title-colour);

      @include bp(tablet) {
        font-size: 24px;
      }

      @include bp(desktop) {
        font-size: 32px;
      }
    }

    .price {
      @include fluid(64, 128);
      font-weight: 700;
      margin: 16px 0;
      position: relative;

      span {
        opacity: 0.4;
        position: relative;
      }

      sup {
        font-size: 36px;
        vertical-align: unset;
        position: absolute;
        top: 25%;
        line-height: 1;
        margin: 0;
      }

      sub {
        vertical-align: initial;
        bottom: 0;
        margin-right: 6px;
        @include fluid(36, 96);
      }
    }

    .btn {
      margin-top: 1rem;
      cursor: pointer;
    }

    .terms {
      max-width: 445px;
      background-color: var(--esk-buy-terms-bg);
      border-radius: 8px;
      padding: 12px 16px;
      font-size: 12px;
      line-height: 1.3;
      color: var(--esk-body-colour);
      margin: 0;
      text-wrap: balance;
    }
  }
</style>
