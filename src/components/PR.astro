---
/**
 * PR Component
 * Creates a link to a GitHub pull request.
 *
 * Usage in MDX:
 * <PR number={123} />
 * <PR number={123} repo="esphome-docs" />
 */

interface Props {
  number: number | string;
  repo?: string;
}

const { number, repo = 'esphome' } = Astro.props;
const url = `https://github.com/esphome/${repo}/pull/${number}`;
---

<a href={url} target="_blank" rel="noopener noreferrer">{repo}#{number}</a>
