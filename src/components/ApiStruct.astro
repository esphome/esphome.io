---
/**
 * ApiStruct Component
 * Creates a link to a C++ struct in the API documentation.
 *
 * Usage:
 *   <ApiStruct text="SensorStateClass" path="esphome::sensor::SensorStateClass" />
 */

interface Props {
  text: string;
  path: string;
}

const { text, path } = Astro.props;

// Get API docs URL from environment
const apiDocsUrl = import.meta.env.API_DOCS_URL || 'https://api-docs.esphome.io';

// Process the path to create the API URL
const pathParts = path.split('/');
const lastElement = pathParts[pathParts.length - 1];

// Process special characters
let processedPath = lastElement
  .replace(/_/g, '__')
  .replace(/\./g, '_8')
  .replace(/:/g, '_1');

// Convert capital letters to lowercase preceded by underscore
processedPath = processedPath.replace(/[A-Z]/g, (match) => `_${match.toLowerCase()}`);

const url = `${apiDocsUrl}/structesphome_1_1${processedPath}`;
---

<a href={url} target="_blank" rel="noopener noreferrer">{text}</a>
