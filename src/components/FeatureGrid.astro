---
/**
 * FeatureGrid Component
 * Creates a grid of feature cards with icons, titles, and descriptions.
 *
 * Usage:
 *   <FeatureGrid features={[
 *     { icon: "code", title: "No Coding Required", description: "Simple YAML configuration" },
 *     { icon: "wifi", title: "Wireless Updates", description: "Update over-the-air" }
 *   ]} />
 */

interface FeatureItem {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  features: FeatureItem[];
}

const { features } = Astro.props;

// Icon mapping - you can expand this with actual SVG paths or Font Awesome classes
