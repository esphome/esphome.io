---
import Default from "@astrojs/starlight/components/MobileMenuToggle.astro";
---

<Default {...Astro.props} />

<style>
  :global(starlight-menu-button button) {
    top: calc(var(--sl-nav-height) + (var(--sl-mobile-toc-height) - var(--sl-menu-button-size)) / 2);
  }

  :global(.sidebar-content) {
    padding-top: calc(1rem + var(--sl-mobile-toc-height));
  }
</style>
