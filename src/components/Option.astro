---
/**
 * Option Component
 * Creates an option block for command line flags or configuration options.
 *
 * Usage:
 *   <Option name="--help|-h">
 *     This is the help option.
 *   </Option>
 */

interface Props {
  name: string;
}

const { name } = Astro.props;
---

<div class="option">
  <div class="option-title"><code>{name}</code></div>
  <slot />
</div>
