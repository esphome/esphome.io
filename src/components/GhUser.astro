---
/**
 * GhUser Component
 * Creates a link to a GitHub user profile.
 *
 * Usage:
 *   <GhUser name="octocat" />
 *   <GhUser name="octocat" text="Octocat User" />
 */

interface Props {
  name: string;
  text?: string;
}

const { name, text } = Astro.props;
const displayText = text || `@${name}`;
const url = `https://github.com/${name}`;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="gh-link">
  {displayText}
</a>
